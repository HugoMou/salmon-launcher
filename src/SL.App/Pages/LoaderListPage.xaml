<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SL.App.Pages.LoaderListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,32" Spacing="16" MinWidth="560" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="加载器选择"
                           Style="{ThemeResource TitleLargeTextBlockStyle}"
                           Foreground="{ThemeResource Brush.Fg}" />
                <TextBlock x:Name="SummaryText"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource Brush.FgDim}" />
            </StackPanel>

            <ItemsControl x:Name="LoaderList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource Brush.Card}"
                                BorderBrush="{ThemeResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18,14"
                                Margin="0,0,0,10">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="11" Background="{ThemeResource Brush.AccentSoft}">
                                    <FontIcon Glyph="{Binding Glyph}" FontSize="18" Foreground="{ThemeResource Brush.Accent}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                                        <Border Background="{ThemeResource Brush.AccentSoft}" CornerRadius="6" Padding="6,1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Tag}" FontSize="10.5" Foreground="{ThemeResource Brush.Accent}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}"
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource Brush.FgDim}" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Content="选择"
                                        Command="{Binding ChooseCommand}"
                                        IsEnabled="{Binding Available}"
                                        VerticalAlignment="Center"
                                        Padding="16,6" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>