<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SL.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="36,28,36,28" Spacing="16" MaxWidth="960" HorizontalAlignment="Stretch">
            <TextBlock Text="外观与设置"
                       Style="{ThemeResource TitleLargeTextBlockStyle}"
                       Foreground="{ThemeResource Brush.Fg}" />
            <TextBlock Text="账户、主题外观与下载参数;所有改动立即生效并自动落盘。"
                       Foreground="{ThemeResource Brush.FgDim}"
                       Margin="0,-12,0,8" />

            <!-- 账户 -->
            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22"
                    HorizontalAlignment="Stretch">
                <StackPanel x:Name="AccountRoot" Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE77B;" FontSize="20" Foreground="{ThemeResource Brush.Accent}" />
                        <TextBlock Text="账户" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Width="52" Height="52" CornerRadius="26" Background="{ThemeResource Brush.AccentSoft}">
                            <FontIcon Glyph="&#xE77B;" FontSize="24" Foreground="{ThemeResource Brush.Accent}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Summary}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource Brush.Fg}" />
                            <TextBlock Text="{Binding Detail}"
                                       FontSize="12"
                                       Foreground="{ThemeResource Brush.FgDim}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Command="{Binding LoginCommand}"
                                Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8FA;" FontSize="14" />
                                <TextBlock Text="正版登录(设备码)" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding LogoutCommand}"
                                Visibility="{Binding LogoutVisibility}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                                <TextBlock Text="退出正版登录" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Foreground="{ThemeResource Brush.FgFaint}"
                               FontSize="11.5"
                               LineHeight="19"
                               TextWrapping="Wrap"
                               Text="正版登录采用 PCL 式设备码流程:启动器给出一组大字代码,你复制到 microsoft.com/link 粘贴完成授权;全程无需在浏览器地址栏复制任何内容。" />
                </StackPanel>
            </Border>

            <!-- 外观 -->
            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22"
                    HorizontalAlignment="Stretch">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE790;" FontSize="20" Foreground="{ThemeResource Brush.Accent}" />
                        <TextBlock Text="外观" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="深浅色" Width="92" VerticalAlignment="Center" Foreground="{ThemeResource Brush.FgDim}" />
                        <RadioButtons x:Name="ThemeMode" SelectionChanged="OnThemeChanged">
                            <RadioButton Content="跟随系统" />
                            <RadioButton Content="浅色" />
                            <RadioButton Content="深色" />
                        </RadioButtons>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="配色" Width="92" VerticalAlignment="Center" Foreground="{ThemeResource Brush.FgDim}" />
                        <RadioButtons x:Name="PaletteList" SelectionChanged="OnPaletteChanged" MaxColumns="4">
                            <RadioButton Content="鲑鱼粉" />
                            <RadioButton Content="水墨" />
                            <RadioButton Content="沙金" />
                            <RadioButton Content="岩灰" />
                        </RadioButtons>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="强调色" Width="92" VerticalAlignment="Center" Foreground="{ThemeResource Brush.FgDim}" />
                        <RadioButtons x:Name="AccentList" SelectionChanged="OnAccentChanged" MaxColumns="5">
                            <RadioButton Content="珊瑚" />
                            <RadioButton Content="海洋" />
                            <RadioButton Content="森林" />
                            <RadioButton Content="紫罗兰" />
                            <RadioButton Content="琥珀" />
                        </RadioButtons>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 下载 -->
            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22"
                    HorizontalAlignment="Stretch">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE896;" FontSize="20" Foreground="{ThemeResource Brush.Accent}" />
                        <TextBlock Text="下载" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="下载并发" Width="92" VerticalAlignment="Center" Foreground="{ThemeResource Brush.FgDim}" />
                        <NumberBox x:Name="ConcurrencyBox"
                                   Minimum="2"
                                   Maximum="16"
                                   SmallChange="1"
                                   SpinButtonPlacementMode="Compact"
                                   Width="140"
                                   ValueChanged="OnConcurrencyChanged" />
                        <TextBlock Text="同时进行的下载数(2–16)"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource Brush.FgFaint}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
