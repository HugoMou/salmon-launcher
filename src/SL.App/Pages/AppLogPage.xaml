<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SL.App.Pages.AppLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="36,28,36,28" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="应用日志"
                           Style="{ThemeResource TitleLargeTextBlockStyle}"
                           Foreground="{ThemeResource Brush.Fg}" />
                <TextBlock Text="{Binding Summary}"
                           FontSize="12"
                           Foreground="{ThemeResource Brush.FgDim}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Button Command="{Binding RefreshCommand}" Content="刷新" />
                <Button Command="{Binding OpenDirCommand}" Content="打开日志目录" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{ThemeResource Brush.Card}"
                BorderBrush="{ThemeResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox ItemsSource="{Binding Files}"
                          SelectedItem="{Binding SelectedFile}"
                          MinWidth="320"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox x:Name="KeywordBox"
                         PlaceholderText="关键词过滤(如 ERROR)"
                         Width="240"
                         TextChanged="OnKeywordChanged"
                         VerticalAlignment="Center" />
                <CheckBox Content="仅看错误"
                          IsChecked="{Binding ErrorsOnly, Mode=TwoWay}"
                          VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{ThemeResource Brush.Card}"
                BorderBrush="{ThemeResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="6">
            <ScrollViewer>
                <TextBlock Text="{Binding LogText}"
                           FontFamily="Consolas"
                           FontSize="12"
                           IsTextSelectionEnabled="True"
                           Foreground="{ThemeResource Brush.FgDim}"
                           TextWrapping="NoWrap"
                           Padding="10,8" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>