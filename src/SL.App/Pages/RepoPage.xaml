<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SL.App.Pages.RepoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
        <Grid Margin="36,28,36,32" MinWidth="620" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Title}"
                           Style="{ThemeResource TitleLargeTextBlockStyle}"
                           Foreground="{ThemeResource Brush.Fg}" />
                <TextBlock Text="{Binding Status}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource Brush.FgDim}" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             PlaceholderText="{Binding SearchHint}"
                             MinWidth="180"
                             KeyDown="OnSearchKeyDown"
                             VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Command="{Binding SearchCommand}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Content="搜索"
                            VerticalAlignment="Center" />
                    <ProgressRing Grid.Column="2"
                                  IsActive="True"
                                  Width="18"
                                  Height="18"
                                  Visibility="{Binding BusyVisibility}"
                                  VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding TargetText}"
                               FontSize="11.5"
                               MaxWidth="260"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource Brush.FgFaint}" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8"
                    MinHeight="220"
                    MaxHeight="760">
                <ListView ItemsSource="{Binding Rows}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="14" Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource Brush.Fg}" />
                                        <TextBlock Text="{Binding Downloads}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource Brush.Accent}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource Brush.FgDim}" />
                                    <TextBlock Text="{Binding Categories}"
                                               FontSize="10.5"
                                               Foreground="{ThemeResource Brush.FgFaint}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="{Binding Author}"
                                               FontSize="10.5"
                                               HorizontalAlignment="Right"
                                               Foreground="{ThemeResource Brush.FgFaint}" />
                                    <Button Command="{Binding InstallCommand}"
                                            Content="下载并安装"
                                            Padding="14,5" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
