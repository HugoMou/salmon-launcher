<Page
    x:Class="SL.App.Pages.CrashDiagPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="36,28,36,28" RowSpacing="14">
        <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="240" />
            </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="崩溃诊断"
                           Style="{ThemeResource TitleLargeTextBlockStyle}"
                           Foreground="{ThemeResource Brush.Fg}" />
                <TextBlock Text="{Binding Summary}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource Brush.FgDim}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Command="{Binding RescanCommand}"
                    Content="重新扫描"
                    VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.3*" MinWidth="220" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="可诊断的报告 / 日志"
                               FontSize="12"
                               Foreground="{ThemeResource Brush.FgDim}"
                               Margin="6,2,0,0" />
                    <ListView Grid.Row="1"
                              ItemsSource="{Binding Files}"
                              SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="1" Padding="0,4">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}"
                                               FontSize="10.5"
                                               Foreground="{ThemeResource Brush.FgFaint}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="12">
                    <Border Background="{ThemeResource Brush.Card}"
                            BorderBrush="{ThemeResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7BA;" FontSize="17" Foreground="{ThemeResource Brush.Accent}" />
                                <TextBlock Text="诊断结论" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Findings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource Brush.WarningSoft}"
                                                CornerRadius="8"
                                                Padding="12,9"
                                                Margin="0,0,0,8">
                                            <TextBlock Text="{Binding}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{ThemeResource Brush.Fg}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding FindingsEmptyHint}"
                                       FontSize="12"
                                       Foreground="{ThemeResource Brush.FgFaint}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding FindingsEmptyVisibility}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource Brush.Card}"
                            BorderBrush="{ThemeResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8A5;" FontSize="17" Foreground="{ThemeResource Brush.Accent}" />
                                <TextBlock Text="报告摘录" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Excerpt}"
                                       FontFamily="Consolas"
                                       FontSize="11.5"
                                       IsTextSelectionEnabled="True"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource Brush.FgDim}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>