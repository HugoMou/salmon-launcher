<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SL.App.Pages.TermsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
        <StackPanel Margin="36,28,36,36" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="用户协议与免责声明"
                       Style="{ThemeResource TitleLargeTextBlockStyle}"
                       Foreground="{ThemeResource Brush.Fg}" />
            <TextBlock Text="版本 1.0 · 使用本软件即表示你已阅读并接受以下全部条款。"
                       Foreground="{ThemeResource Brush.FgDim}"
                       Margin="0,-12,0,4"
                       TextWrapping="Wrap" />

            <!-- 同意状态 -->
            <Border Background="{ThemeResource Brush.AccentSoft}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE73E;"
                              FontSize="18"
                              Foreground="{ThemeResource Brush.Accent}"
                              VerticalAlignment="Center" />
                    <TextBlock x:Name="AcceptStateText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="12.5"
                               Foreground="{ThemeResource Brush.Fg}" />
                    <Button x:Name="AcceptButton"
                            Grid.Column="2"
                            Style="{ThemeResource AccentButtonStyle}"
                            Content="同意并继续"
                            Click="OnAccept"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24">
                <StackPanel Spacing="18">

                    <StackPanel Spacing="6">
                        <TextBlock Text="一、总则" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="Salmon Launcher(以下简称「本软件」)是一款用于管理、安装与启动 Minecraft 的第三方桌面工具。本协议是你与本软件作者之间关于使用本软件的约定。若你不同意其中任何条款,请停止使用并删除本软件。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="二、账号与凭据" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="1. 微软账户登录由微软官方 OAuth 页面完成,本软件不会接触也不保存你的密码,仅在本地保存登录后获得的访问令牌与刷新令牌。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="2. 所有账户信息与令牌都保存在本机数据目录中,不会上传到任何服务器。你可以随时在「外观与设置」中删除账户,或直接删除数据目录。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="3. 离线账户仅用于本地游戏,不具备正版身份,无法进入开启了正版验证的服务器。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="三、游戏文件与数据" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="1. 游戏本体、运行库与资源文件均从 Mojang 官方源或其公开镜像下载,本软件不分发、不修改、不内置任何 Minecraft 游戏文件。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="2. 模组、光影与资源包来自 Modrinth 等公开平台,其版权与许可归各自作者所有,请遵守对应项目的授权条款。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="3. 实例、存档、日志与皮肤都保存在本机数据目录,卸载本软件不会自动删除,请自行备份。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="四、使用规范" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="1. 你应当拥有你所使用的 Minecraft 账户,并通过正规渠道获取游戏。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="2. 不得利用本软件绕过正版验证、发布破解内容、传播恶意文件,或从事任何违反当地法律法规的行为。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="3. 联机功能依赖你自己的网络环境与自建中继,请勿用于未经授权的入侵或流量攻击。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="五、第三方服务" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="本软件会访问 Mojang 版本元数据、BMCLAPI 镜像、Modrinth 接口、GitHub 与 Eclipse Temurin 等第三方服务。这些服务由其运营方独立提供,并适用各自的条款与隐私政策,本软件不对其可用性与内容承担责任。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="六、隐私" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="本软件不含任何统计、埋点或广告组件,不会收集你的设备信息、游戏行为或个人信息。仅在排查问题时,你主动分享的日志文件会被读取。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="七、免责声明" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="1. 本软件为第三方免费工具,与 Mojang Studios、Microsoft 无任何隶属或授权关系,Minecraft 是 Mojang Studios 的商标。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="2. 软件按「现状」提供,作者不对下载失败、存档损坏、账户异常或任何间接损失作出担保与赔偿;请在重要操作前自行备份存档。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="八、协议变更" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="本协议可能随功能演进更新,更新后的条款随新版本一同发布。若你在条款更新后继续使用本软件,视为接受更新内容。" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
