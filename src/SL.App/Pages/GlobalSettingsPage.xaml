<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SL.App.Pages.GlobalSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,32" Spacing="16" MinWidth="640" MaxWidth="960" HorizontalAlignment="Left">
            <TextBlock Text="全局偏好"
                       Style="{ThemeResource TitleLargeTextBlockStyle}"
                       Foreground="{ThemeResource Brush.Fg}" />
            <TextBlock Text="内存、窗口、JVM 参数与下载源;所有改动立即生效并自动落盘。"
                       Foreground="{ThemeResource Brush.FgDim}"
                       Margin="0,-12,0,8" />

            <!-- 运行 -->
            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE7FC;" FontSize="20" Foreground="{ThemeResource Brush.Accent}" />
                        <TextBlock Text="游戏运行" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="内存分配" Width="96" VerticalAlignment="Center"
                                   Foreground="{ThemeResource Brush.FgDim}" />
                        <NumberBox x:Name="MemoryBox"
                                   Minimum="512"
                                   Maximum="32768"
                                   SmallChange="512"
                                   SpinButtonPlacementMode="Compact"
                                   Width="150"
                                   ValueChanged="OnMemoryChanged" />
                        <TextBlock Text="MB(建议 4096;模组较多可上调)"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource Brush.FgFaint}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="窗口尺寸" Width="96" VerticalAlignment="Center"
                                   Foreground="{ThemeResource Brush.FgDim}" />
                        <NumberBox x:Name="WidthBox"
                                   Minimum="320"
                                   Maximum="7680"
                                   SmallChange="10"
                                   SpinButtonPlacementMode="Compact"
                                   Width="130"
                                   ValueChanged="OnWindowChanged" />
                        <TextBlock Text="×" VerticalAlignment="Center" Foreground="{ThemeResource Brush.FgFaint}" />
                        <NumberBox x:Name="HeightBox"
                                   Minimum="240"
                                   Maximum="4320"
                                   SmallChange="10"
                                   SpinButtonPlacementMode="Compact"
                                   Width="130"
                                   ValueChanged="OnWindowChanged" />
                        <TextBlock Text="像素"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource Brush.FgFaint}" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="附加 JVM 参数(空格分隔)"
                                   Foreground="{ThemeResource Brush.FgDim}" />
                        <TextBox x:Name="JvmBox"
                                 PlaceholderText="例:-XX:+UseG1GC -Dfile.encoding=UTF-8"
                                 LostFocus="OnJvmChanged" />
                        <TextBlock Text="会追加在 -Xmx 之后、主类之前;留空表示不附加。"
                                   FontSize="11.5"
                                   Foreground="{ThemeResource Brush.FgFaint}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 下载 -->
            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE896;" FontSize="20" Foreground="{ThemeResource Brush.Accent}" />
                        <TextBlock Text="下载源" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Style="{StaticResource Style.SegmentHost}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <RadioButton x:Name="SourceAuto"
                                         GroupName="Source"
                                         Content="自动(官方主源,失败切换镜像)"
                                         Style="{StaticResource Style.Segment}"
                                         Checked="OnSourceChecked" />
                            <RadioButton x:Name="SourceMirror"
                                         GroupName="Source"
                                         Content="镜像优先(国内网络更快)"
                                         Style="{StaticResource Style.Segment}"
                                         Checked="OnSourceChecked" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="镜像仅在官方源不可达或校验失败时使用;文件最终都会做 SHA-1 校验。"
                               FontSize="11.5"
                               Foreground="{ThemeResource Brush.FgFaint}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 环境 -->
            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE90F;" FontSize="20" Foreground="{ThemeResource Brush.Accent}" />
                        <TextBlock Text="环境与数据" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="数据目录" Width="96" VerticalAlignment="Center"
                                   Foreground="{ThemeResource Brush.FgDim}" />
                        <TextBlock x:Name="RootText"
                                   Grid.Column="1"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   IsTextSelectionEnabled="True"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource Brush.FgDim}" />
                        <Button Grid.Column="2" Content="打开" Click="OnOpenRoot" Padding="14,5" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Java 环境" Width="96" VerticalAlignment="Center"
                                   Foreground="{ThemeResource Brush.FgDim}" />
                        <TextBlock x:Name="JavaText"
                                   Grid.Column="1"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource Brush.FgDim}" />
                        <Button Grid.Column="2" Content="重新扫描" Click="OnRescanJava" Padding="14,5" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>