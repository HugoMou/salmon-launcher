<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SL.App.Pages.InstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,32" Spacing="16" MinWidth="620" MaxWidth="860" HorizontalAlignment="Left">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="TitleText"
                               Style="{ThemeResource TitleLargeTextBlockStyle}"
                               Foreground="{ThemeResource Brush.Fg}" />
                    <TextBlock x:Name="StageText"
                               FontSize="12"
                               Foreground="{ThemeResource Brush.FgDim}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="返回版本" Click="OnBack" />
                    <Button x:Name="InstallButton"
                            Style="{ThemeResource AccentButtonStyle}"
                            Content="开始安装"
                            Click="OnInstall" />
                </StackPanel>
            </Grid>

            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="{ThemeResource Brush.Accent}" />
                        <TextBlock Text="安装计划" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl x:Name="PlanList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3">
                                    <TextBlock Text="·" Foreground="{ThemeResource Brush.FgFaint}" />
                                    <TextBlock Text="{Binding}"
                                               FontSize="12.5"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource Brush.FgDim}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">
                <StackPanel Spacing="8">
                    <TextBlock Text="安装位置" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                    <TextBlock x:Name="PathText"
                               FontSize="12"
                               IsTextSelectionEnabled="True"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource Brush.FgDim}" />
                    <TextBlock Text="安装完成后可在「启动面板」选择该实例直接启动;库与资源是跨实例共享的,重复安装不会重复下载。"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource Brush.FgFaint}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>