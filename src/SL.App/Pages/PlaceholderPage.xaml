<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SL.App.Pages.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="36,28,36,28" Spacing="4" MaxWidth="960" HorizontalAlignment="Stretch">
            <TextBlock x:Name="TitleText"
                       Style="{ThemeResource TitleLargeTextBlockStyle}"
                       Foreground="{ThemeResource Brush.Fg}" />
            <TextBlock x:Name="HintText"
                       Foreground="{ThemeResource Brush.FgDim}"
                       TextWrapping="Wrap"
                       Margin="0,2,0,20" />

            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22"
                    HorizontalAlignment="Stretch">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE7BA;"
                                  Foreground="{ThemeResource Brush.Warning}"
                                  FontSize="20" />
                        <TextBlock Text="骨架占位 · 该页面将在页面移植批次实现"
                                   Foreground="{ThemeResource Brush.Fg}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="KeyText"
                               Foreground="{ThemeResource Brush.FgDim}"
                               FontFamily="Consolas"
                               FontSize="12" />
                    <TextBlock Text="外壳已就绪:路由导航、主题(4 配色 × 5 强调色 × 深浅跟随系统)、对话框、提示层、任务中心与下载引擎均已接入;页面内容按批次移植,本占位图仅验证路由与主题资源绑定。"
                               Foreground="{ThemeResource Brush.FgDim}"
                               TextWrapping="Wrap"
                               LineHeight="22" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
