<Page
    x:Class="SL.App.Pages.InstanceLogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="36,28,36,28" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="实例日志"
                           Style="{ThemeResource TitleLargeTextBlockStyle}"
                           Foreground="{ThemeResource Brush.Fg}" />
                <TextBlock x:Name="StatusText"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource Brush.FgDim}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox x:Name="InstanceBox" MinWidth="150" SelectionChanged="OnInstanceChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Id}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="刷新" Click="OnRefresh" />
                <Button Content="到崩溃诊断" Click="OnOpenDiag" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{ThemeResource Brush.Card}"
                BorderBrush="{ThemeResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="KeywordBox"
                         PlaceholderText="关键词过滤(如 ERROR、Exception)"
                         MinWidth="180"
                         TextChanged="OnKeywordChanged"
                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="读取实例 logs/latest.log 尾部 2000 行"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource Brush.FgFaint}" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{ThemeResource Brush.Card}"
                BorderBrush="{ThemeResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="6">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText"
                           FontFamily="Consolas"
                           FontSize="12"
                           IsTextSelectionEnabled="True"
                           TextWrapping="NoWrap"
                           Foreground="{ThemeResource Brush.FgDim}"
                           Padding="10,8" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
