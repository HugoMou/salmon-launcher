<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SL.App.Pages.ThemeWorkshopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SL.App.Pages">

    <ScrollViewer>
        <StackPanel Margin="36,28,36,28" Spacing="16" MaxWidth="1080" HorizontalAlignment="Left">
            <TextBlock Text="主题工坊"
                       Style="{ThemeResource TitleLargeTextBlockStyle}"
                       Foreground="{ThemeResource Brush.Fg}" />
            <TextBlock Text="从 Minecraft 方块纹理里取色,自动推导出一整套界面配色与强调色;点一张方块卡即可换肤。"
                       Foreground="{ThemeResource Brush.FgDim}"
                       TextWrapping="Wrap"
                       Margin="0,-12,0,4" />

            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText"
                                   FontSize="13"
                                   Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock Text="优先读取已安装客户端里的原始贴图;没有安装游戏时自动改为从在线材质镜像下载。"
                                   FontSize="11.5"
                                   Foreground="{ThemeResource Brush.FgFaint}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="RefreshButton" Click="OnRefresh">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="刷新纹理" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnResetTheme">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE777;" FontSize="14" />
                                <TextBlock Text="恢复默认配色" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <GridView x:Name="BlockGrid"
                      IsItemClickEnabled="True"
                      ItemClick="OnBlockClick"
                      SelectionMode="None"
                      Padding="0,4,0,24">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:BlockCard">
                        <Border Background="{ThemeResource Brush.Card}"
                                BorderBrush="{ThemeResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10"
                                Width="150">
                            <StackPanel Spacing="8">
                                <Border CornerRadius="8" Background="{ThemeResource Brush.PageBg}">
                                    <Image Source="{x:Bind Thumb, Mode=OneWay}"
                                           Width="128"
                                           Height="128"
                                           Stretch="Uniform" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Border Width="11" Height="11" CornerRadius="5.5" Background="{x:Bind Dot, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind Name}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource Brush.Fg}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Hex, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource Brush.FgFaint}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</Page>
