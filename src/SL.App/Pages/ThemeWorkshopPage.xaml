<Page
    x:Class="SL.App.Pages.ThemeWorkshopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themes="using:SL.App.Themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
        <StackPanel Margin="36,28,36,32" Spacing="16" MaxWidth="1120" HorizontalAlignment="Left">
            <TextBlock Text="主题工坊"
                       Style="{ThemeResource TitleLargeTextBlockStyle}"
                       Foreground="{ThemeResource Brush.Fg}" />
            <TextBlock Text="用 Minecraft 风格的游戏画面做壁纸,配色自动从画面里取,连同背景一起应用成整套主题。"
                       Foreground="{ThemeResource Brush.FgDim}"
                       TextWrapping="Wrap"
                       Margin="0,-12,0,4" />

            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock x:Name="CurrentText"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource Brush.FgFaint}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Click="OnPickImage">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE722;" FontSize="14" />
                                <TextBlock Text="选择图片" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnClearWallpaper">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="清除壁纸" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnResetTheme" Content="恢复默认配色" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="内置场景"
                       FontSize="12"
                       Foreground="{ThemeResource Brush.FgDim}"
                       Margin="0,4,0,-4" />

            <GridView x:Name="SceneGrid"
                      IsItemClickEnabled="True"
                      ItemClick="OnSceneClick"
                      SelectionMode="None"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.IsVerticalRailEnabled="False"
                      Padding="0,0,0,24">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="themes:WallpaperCard">
                        <Border Background="{ThemeResource Brush.Card}"
                                BorderBrush="{ThemeResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8"
                                Width="252">
                            <StackPanel Spacing="8">
                                <Border CornerRadius="8"
                                        Height="132"
                                        Background="{ThemeResource Brush.PageBg}">
                                    <Image Source="{x:Bind Thumb, Mode=OneWay}"
                                           Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Border Width="11" Height="11" CornerRadius="5.5"
                                            Background="{x:Bind Dot, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind Name}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource Brush.Fg}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Hex, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource Brush.FgFaint}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</Page>
