<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SL.App.Pages.InstanceModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
        <Grid Margin="36,28,36,32" MinWidth="620" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="模组管理"
                               Style="{ThemeResource TitleLargeTextBlockStyle}"
                               Foreground="{ThemeResource Brush.Fg}" />
                    <TextBlock x:Name="StatusText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource Brush.FgDim}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox x:Name="InstanceBox" MinWidth="160" SelectionChanged="OnInstanceChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Id}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="导入模组" Click="OnImport" />
                    <Button Content="打开目录" Click="OnOpenDir" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12">
                <TextBlock Text="启用/停用通过改文件名后缀实现(.disabled 即停用),游戏启动时按文件名加载;删除不可撤销。"
                           FontSize="11.5"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource Brush.FgFaint}" />
            </Border>

            <Border Grid.Row="2"
                    Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8"
                    MinHeight="220"
                    MaxHeight="760">
                <ListView x:Name="ModList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12" Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="9" Background="{ThemeResource Brush.AccentSoft}">
                                    <FontIcon Glyph="{Binding Glyph}" FontSize="16"
                                              Foreground="{ThemeResource Brush.Accent}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource Brush.Fg}" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource Brush.FgFaint}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ToggleSwitch IsOn="{Binding Enabled, Mode=OneWay}"
                                                  OnContent="启用" OffContent="停用"
                                                  Toggled="OnToggleMod"
                                                  MinWidth="0" />
                                    <Button Content="删除" Click="OnDeleteMod" Padding="12,4" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
