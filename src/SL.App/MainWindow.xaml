<Window
    x:Class="SL.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SL.App.Controls"
    xmlns:notify="using:SL.App.Notify">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Theme wallpaper (fills the window, visible under the title bar too) -->
        <Grid x:Name="WallpaperLayer"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              IsHitTestVisible="False">
            <Grid.Background>
                <ImageBrush x:Name="WallpaperBrush" Stretch="UniformToFill" Opacity="0.5" />
            </Grid.Background>
            <Border x:Name="WallpaperScrim" />
        </Grid>

        <!-- Title bar drag area (ExtendsContentIntoTitleBar) -->
        <Grid x:Name="AppTitleBar" Height="48" Background="Transparent">
            <StackPanel Orientation="Horizontal"
                        Margin="14,0,0,0"
                        Spacing="9"
                        VerticalAlignment="Center">
                <!-- App logo (bundled asset Assets\Logo.png) -->
                <Image Source="ms-appx:///Assets/Logo.png"
                       Width="26"
                       Height="26"
                       Stretch="Uniform"
                       VerticalAlignment="Center" />
                <TextBlock Text="SalmonLauncher"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource Brush.Fg}"
                           FontWeight="SemiBold"
                           FontSize="13" />
                <TextBlock x:Name="PageTitleText"
                           Text=""
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource Brush.FgDim}"
                           FontSize="12.5" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsPaneToggleButtonVisible="True"
                        IsPaneOpen="True"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="212"
                        ItemInvoked="OnNavItemInvoked">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            </NavigationView.Resources>

            <NavigationView.Content>
                <Grid x:Name="ContentRoot">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Notification layer (the page title is handled by the title bar and the page itself; only toasts live here) -->
                    <StackPanel Margin="36,14,36,0" Spacing="10">
                        <ItemsControl x:Name="NotifyHost">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="notify:Toast">
                                    <InfoBar Severity="{x:Bind Severity}"
                                             Title="{x:Bind Text}"
                                             IsOpen="{x:Bind IsOpen, Mode=TwoWay}"
                                             IsClosable="True"
                                             Margin="0,0,0,8"
                                             CornerRadius="8"
                                             Background="{ThemeResource Brush.Card}"
                                             BorderBrush="{ThemeResource Brush.Border}"
                                             Foreground="{ThemeResource Brush.Fg}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Page host -->
                    <Border x:Name="PageHost" Grid.Row="1" Background="Transparent">
                        <Frame x:Name="NavFrame" />
                    </Border>
                </Grid>
            </NavigationView.Content>
        </NavigationView>

        <!-- Welcome page: four-step setup on first launch or after clearing data; covers the content area until complete -->
        <controls:OnboardingView x:Name="Onboarding" Grid.RowSpan="2" Visibility="Collapsed" />
    </Grid>
</Window>
