<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SL.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:notify="using:SL.App.Notify">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏拖拽区(ExtendsContentIntoTitleBar) -->
        <Grid x:Name="AppTitleBar" Height="48" Background="Transparent">
            <StackPanel Orientation="Horizontal"
                        Margin="14,0,0,0"
                        Spacing="10"
                        VerticalAlignment="Center">
                <Ellipse Width="18" Height="18" Fill="{ThemeResource Brush.Accent}" />
                <TextBlock Text="Salmon Launcher"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource Brush.Fg}"
                           FontWeight="SemiBold"
                           FontSize="13" />
                <TextBlock x:Name="PageTitleText"
                           Text=""
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource Brush.FgDim}"
                           FontSize="13" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Auto"
                        CompactModeThresholdWidth="1000"
                        ExpandedModeThresholdWidth="1200"
                        IsPaneToggleButtonVisible="True"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="212"
                        ItemInvoked="OnNavItemInvoked">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            </NavigationView.Resources>

            <NavigationView.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 页面标题 + 非模态提示层 -->
                    <StackPanel Margin="36,22,36,0" Spacing="10">
                        <TextBlock x:Name="HeaderText"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource Brush.Fg}" />
                        <ItemsControl x:Name="NotifyHost">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="notify:Toast">
                                    <InfoBar Severity="{x:Bind Severity}"
                                             Title="{x:Bind Text}"
                                             IsOpen="{x:Bind IsOpen, Mode=TwoWay}"
                                             IsClosable="True"
                                             Margin="0,0,0,8"
                                             CornerRadius="8"
                                             Background="{ThemeResource Brush.Card}"
                                             BorderBrush="{ThemeResource Brush.Border}"
                                             Foreground="{ThemeResource Brush.Fg}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 页面宿主 -->
                    <Border Grid.Row="1" Background="{ThemeResource Brush.PageBg}">
                        <Frame x:Name="NavFrame" />
                    </Border>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
