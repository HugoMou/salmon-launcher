<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SL.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:notify="using:SL.App.Notify">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 主题壁纸(铺满窗口,标题栏下也可见) -->
        <Grid x:Name="WallpaperLayer"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              IsHitTestVisible="False">
            <Grid.Background>
                <ImageBrush x:Name="WallpaperBrush" Stretch="UniformToFill" Opacity="0.5" />
            </Grid.Background>
            <Border x:Name="WallpaperScrim" />
        </Grid>

        <!-- 标题栏拖拽区(ExtendsContentIntoTitleBar) -->
        <Grid x:Name="AppTitleBar" Height="48" Background="Transparent">
            <StackPanel Orientation="Horizontal"
                        Margin="14,0,0,0"
                        Spacing="9"
                        VerticalAlignment="Center">
                <!-- 应用 Logo:鲑鱼侧影 -->
                <Viewbox Width="24" Height="24">
                    <Canvas Width="32" Height="32">
                        <Path Fill="{ThemeResource Brush.Accent}"
                              Data="M3,17 C8,11 18,8 25,11 C27,12 28.6,13.6 29.2,15 C28.6,16.4 27,18 25,19 C18,22 8,19 3,17 Z" />
                        <Path Fill="{ThemeResource Brush.Accent}"
                              Data="M3.4,17 L0.4,12.2 L0.4,21.8 Z" />
                        <Ellipse Canvas.Left="23" Canvas.Top="13" Width="2.4" Height="2.4"
                                 Fill="{ThemeResource Brush.AccentFg}" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="Salmon Launcher"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource Brush.Fg}"
                           FontWeight="SemiBold"
                           FontSize="13" />
                <TextBlock x:Name="PageTitleText"
                           Text=""
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource Brush.FgDim}"
                           FontSize="12.5" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsPaneToggleButtonVisible="True"
                        IsPaneOpen="True"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="212"
                        ItemInvoked="OnNavItemInvoked">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            </NavigationView.Resources>

            <NavigationView.Content>
                <Grid x:Name="ContentRoot">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 提示层(页面标题由标题栏与页面自身承担,这里只放 toast) -->
                    <StackPanel Margin="36,14,36,0" Spacing="10">
                        <ItemsControl x:Name="NotifyHost">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="notify:Toast">
                                    <InfoBar Severity="{x:Bind Severity}"
                                             Title="{x:Bind Text}"
                                             IsOpen="{x:Bind IsOpen, Mode=TwoWay}"
                                             IsClosable="True"
                                             Margin="0,0,0,8"
                                             CornerRadius="8"
                                             Background="{ThemeResource Brush.Card}"
                                             BorderBrush="{ThemeResource Brush.Border}"
                                             Foreground="{ThemeResource Brush.Fg}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 页面宿主 -->
                    <Border x:Name="PageHost" Grid.Row="1" Background="Transparent">
                        <Frame x:Name="NavFrame" />
                    </Border>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
