<ContentDialog
    x:Class="SL.App.Dialogs.DeviceCodeLoginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="登录正版账户"
    CloseButtonText="关闭"
    DefaultButton="Close">

    <StackPanel MinWidth="440" Spacing="14">
        <TextBlock Foreground="{ThemeResource Brush.FgDim}"
                   TextWrapping="Wrap"
                   Text="第 1 步:点击「打开登录页」,浏览器将转到 microsoft.com/link;" />
        <TextBlock Foreground="{ThemeResource Brush.FgDim}"
                   TextWrapping="Wrap"
                   Text="第 2 步:登录微软账户,粘贴下面的设备码(全程无需复制地址栏内容)。" />

        <Border Background="{ThemeResource Brush.Card}"
                BorderBrush="{ThemeResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18,14">
            <StackPanel Spacing="12">
                <TextBlock x:Name="CodeText"
                           Text="· · · · · · · · ·"
                           FontFamily="Consolas"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="{ThemeResource Brush.Accent}"
                           HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="10">
                    <Button x:Name="CopyButton"
                            IsEnabled="False"
                            Click="OnCopy">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            <TextBlock Text="复制设备码" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenButton"
                            IsEnabled="False"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="OnOpen">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                            <TextBlock Text="打开登录页" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <ProgressRing x:Name="BusyRing"
                          Width="18"
                          Height="18"
                          IsActive="True" />
            <FontIcon x:Name="ErrorIcon"
                      Glyph="&#xE783;"
                      FontSize="16"
                      Foreground="{ThemeResource Brush.Danger}"
                      Visibility="Collapsed"
                      VerticalAlignment="Center" />
            <TextBlock x:Name="StepText"
                       Text="正在向微软申请设备码…"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
