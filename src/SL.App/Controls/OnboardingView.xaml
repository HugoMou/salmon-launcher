<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SL.App.Controls.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:SL.App.Pages">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 第 0 行刻意留空:标题栏(窗口拖拽区)保持可见可用 -->
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="1" Background="{ThemeResource Brush.PageBg}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled">
                <StackPanel MaxWidth="760"
                            Margin="60,44,60,36"
                            HorizontalAlignment="Center"
                            Spacing="18">

                    <!-- 头部 -->
                    <StackPanel Orientation="Horizontal" Spacing="11" HorizontalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Logo.png"
                               Width="32"
                               Height="32"
                               Stretch="Uniform"
                               VerticalAlignment="Center" />
                        <TextBlock Text="欢迎使用 Salmon Launcher"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource Brush.Fg}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 步骤指示:四个圆点(完成后打勾) + 下方进度条 -->
                    <StackPanel Spacing="9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="5" HorizontalAlignment="Center">
                                <Grid Width="32" Height="32">
                                    <Ellipse x:Name="DotPending0" Width="32" Height="32" Fill="{ThemeResource Brush.PanelBg}" Stroke="{ThemeResource Brush.Border}" StrokeThickness="2" />
                                    <Ellipse x:Name="DotCurrent0" Width="32" Height="32" Fill="Transparent" Stroke="{ThemeResource Brush.Accent}" StrokeThickness="2" Visibility="Collapsed" />
                                    <Ellipse x:Name="DotDone0" Width="32" Height="32" Fill="{ThemeResource Brush.Accent}" Visibility="Collapsed" />
                                    <TextBlock x:Name="DotNum0" Text="1" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource Brush.FgDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <FontIcon x:Name="DotTick0" Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource Brush.AccentFg}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="DotLabel0" Text="语言" FontSize="11" Foreground="{ThemeResource Brush.FgFaint}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="5" HorizontalAlignment="Center">
                                <Grid Width="32" Height="32">
                                    <Ellipse x:Name="DotPending1" Width="32" Height="32" Fill="{ThemeResource Brush.PanelBg}" Stroke="{ThemeResource Brush.Border}" StrokeThickness="2" />
                                    <Ellipse x:Name="DotCurrent1" Width="32" Height="32" Fill="Transparent" Stroke="{ThemeResource Brush.Accent}" StrokeThickness="2" Visibility="Collapsed" />
                                    <Ellipse x:Name="DotDone1" Width="32" Height="32" Fill="{ThemeResource Brush.Accent}" Visibility="Collapsed" />
                                    <TextBlock x:Name="DotNum1" Text="2" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource Brush.FgDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <FontIcon x:Name="DotTick1" Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource Brush.AccentFg}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="DotLabel1" Text="条款" FontSize="11" Foreground="{ThemeResource Brush.FgFaint}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="5" HorizontalAlignment="Center">
                                <Grid Width="32" Height="32">
                                    <Ellipse x:Name="DotPending2" Width="32" Height="32" Fill="{ThemeResource Brush.PanelBg}" Stroke="{ThemeResource Brush.Border}" StrokeThickness="2" />
                                    <Ellipse x:Name="DotCurrent2" Width="32" Height="32" Fill="Transparent" Stroke="{ThemeResource Brush.Accent}" StrokeThickness="2" Visibility="Collapsed" />
                                    <Ellipse x:Name="DotDone2" Width="32" Height="32" Fill="{ThemeResource Brush.Accent}" Visibility="Collapsed" />
                                    <TextBlock x:Name="DotNum2" Text="3" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource Brush.FgDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <FontIcon x:Name="DotTick2" Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource Brush.AccentFg}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="DotLabel2" Text="账户" FontSize="11" Foreground="{ThemeResource Brush.FgFaint}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Spacing="5" HorizontalAlignment="Center">
                                <Grid Width="32" Height="32">
                                    <Ellipse x:Name="DotPending3" Width="32" Height="32" Fill="{ThemeResource Brush.PanelBg}" Stroke="{ThemeResource Brush.Border}" StrokeThickness="2" />
                                    <Ellipse x:Name="DotCurrent3" Width="32" Height="32" Fill="Transparent" Stroke="{ThemeResource Brush.Accent}" StrokeThickness="2" Visibility="Collapsed" />
                                    <Ellipse x:Name="DotDone3" Width="32" Height="32" Fill="{ThemeResource Brush.Accent}" Visibility="Collapsed" />
                                    <TextBlock x:Name="DotNum3" Text="4" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource Brush.FgDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <FontIcon x:Name="DotTick3" Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource Brush.AccentFg}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="DotLabel3" Text="主题" FontSize="11" Foreground="{ThemeResource Brush.FgFaint}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar x:Name="StepBar" Minimum="0" Maximum="4" Value="0" Height="6" />
                        <TextBlock x:Name="ProgressText"
                                   Text="已完成 0/4"
                                   FontSize="11"
                                   Foreground="{ThemeResource Brush.FgFaint}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 步骤内容 -->
                    <Border Background="{ThemeResource Brush.Card}"
                            BorderBrush="{ThemeResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="26,22">
                        <Grid x:Name="Panels" MinHeight="300">

                            <!-- 第 1 页:选择语言 -->
                            <StackPanel x:Name="PanelLang" Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="选择语言"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource Brush.Fg}" />
                                    <TextBlock Text="选择启动器的界面语言,选择后立即生效;之后可随时在「外观与设置」中更改。"
                                               FontSize="12.5"
                                               Foreground="{ThemeResource Brush.FgDim}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel x:Name="LangList" Spacing="8" />
                            </StackPanel>

                            <!-- 第 2 页:同意条款 -->
                            <StackPanel x:Name="PanelTerms" Spacing="12" Visibility="Collapsed">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="用户协议与免责声明"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource Brush.Fg}" />
                                    <TextBlock Text="请阅读并同意以下条款后再继续。"
                                               FontSize="12.5"
                                               Foreground="{ThemeResource Brush.FgDim}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ScrollViewer MaxHeight="196"
                                              Background="{ThemeResource Brush.PageBg}"
                                              BorderBrush="{ThemeResource Brush.Border}"
                                              BorderThickness="1"
                                              CornerRadius="10">
                                    <StackPanel Spacing="10" Padding="15,12">
                                        <TextBlock Style="{StaticResource Style.TermsBody}"
                                                   Text="Salmon Launcher 为第三方免费工具,与 Mojang Studios、Microsoft 无隶属或授权关系;Minecraft 是 Mojang Studios 的商标。" />
                                        <TextBlock Style="{StaticResource Style.TermsBody}"
                                                   Text="本软件不含任何统计、埋点或广告组件,不会收集你的设备信息、游戏行为或个人信息。仅在排查问题时,你主动分享的日志文件会被读取。" />
                                        <TextBlock Style="{StaticResource Style.TermsBody}"
                                                   Text="版本 1.0 · 使用本软件即表示你已阅读并接受以下全部条款。" />
                                    </StackPanel>
                                </ScrollViewer>
                                <CheckBox x:Name="TermsCheck"
                                          Content="我已阅读并同意以上条款"
                                          Checked="OnTermsToggled"
                                          Unchecked="OnTermsToggled" />
                            </StackPanel>

                            <!-- 第 3 页:登录正版或创建离线账户 -->
                            <StackPanel x:Name="PanelAccount" Spacing="14" Visibility="Collapsed">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="登录账户"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource Brush.Fg}" />
                                    <TextBlock Text="登录正版账号,或创建一个离线账号;两种账户都可随时在设置里切换。"
                                               FontSize="12.5"
                                               Foreground="{ThemeResource Brush.FgDim}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel x:Name="AccountRoot" Orientation="Horizontal" Spacing="14">
                                    <Border Width="50" Height="50" CornerRadius="25" Background="{ThemeResource Brush.AccentSoft}">
                                        <FontIcon Glyph="{Binding ActiveGlyph}"
                                                  FontSize="22"
                                                  Foreground="{ThemeResource Brush.Accent}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Summary}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource Brush.Fg}" />
                                        <TextBlock Text="{Binding Detail}"
                                                   FontSize="11.5"
                                                   Foreground="{ThemeResource Brush.FgDim}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Command="{Binding LoginPremiumCommand}" Style="{ThemeResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE774;" FontSize="14" />
                                            <TextBlock Text="正版授权登录" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding AddOfflineCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                                            <TextBlock Text="添加离线账户" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="AccountHint"
                                           Text="还没有账户:登录正版或创建离线账户后才能继续。"
                                           FontSize="11.5"
                                           Foreground="{ThemeResource Brush.Warning}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>

                            <!-- 第 4 页:选择主题(可跳过) -->
                            <StackPanel x:Name="PanelTheme" Spacing="14" Visibility="Collapsed">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="选择主题"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource Brush.Fg}" />
                                    <TextBlock Text="选择深浅色、配色方案与强调色;本页可以跳过,之后随时能改。"
                                               FontSize="12.5"
                                               Foreground="{ThemeResource Brush.FgDim}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="深浅色" VerticalAlignment="Center" Foreground="{ThemeResource Brush.FgDim}" />
                                    <Border Grid.Column="1" Style="{StaticResource Style.SegmentHost}">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <RadioButton x:Name="ModeSystem"
                                                         GroupName="ObThemeMode"
                                                         Content="跟随系统"
                                                         Style="{StaticResource Style.Segment}"
                                                         Checked="OnModeChecked" />
                                            <RadioButton x:Name="ModeLight"
                                                         GroupName="ObThemeMode"
                                                         Content="浅色"
                                                         Style="{StaticResource Style.Segment}"
                                                         Checked="OnModeChecked" />
                                            <RadioButton x:Name="ModeDark"
                                                         GroupName="ObThemeMode"
                                                         Content="深色"
                                                         Style="{StaticResource Style.Segment}"
                                                         Checked="OnModeChecked" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Spacing="8">
                                    <TextBlock Text="配色方案" Foreground="{ThemeResource Brush.FgDim}" />
                                    <GridView x:Name="PaletteGrid"
                                              SelectionMode="None"
                                              IsItemClickEnabled="True"
                                              ItemClick="OnPaletteClick"
                                              Padding="0"
                                              ScrollViewer.HorizontalScrollMode="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollMode="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="pages:PaletteCardVM">
                                                <Border Background="{ThemeResource Brush.Card}"
                                                        BorderBrush="{ThemeResource Brush.Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="11,10"
                                                        Width="150">
                                                    <StackPanel Spacing="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <Border Width="32" Height="9" CornerRadius="4.5" Background="{x:Bind Swatch1}" />
                                                            <Border Width="32" Height="9" CornerRadius="4.5" Background="{x:Bind Swatch2}" />
                                                            <Border Width="32" Height="9" CornerRadius="4.5" Background="{x:Bind Swatch3}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{x:Bind Name}"
                                                                       FontSize="12"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{ThemeResource Brush.Fg}" />
                                                            <FontIcon Glyph="&#xE73E;"
                                                                      FontSize="11"
                                                                      Foreground="{ThemeResource Brush.Accent}"
                                                                      Visibility="{x:Bind CheckVisibility}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </StackPanel>

                                <StackPanel Spacing="8">
                                    <TextBlock Text="强调色" Foreground="{ThemeResource Brush.FgDim}" />
                                    <ItemsControl x:Name="AccentList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="pages:AccentCardVM">
                                                <StackPanel Tapped="OnAccentTapped"
                                                            ToolTipService.ToolTip="{x:Bind Name}"
                                                            Spacing="5"
                                                            Width="56">
                                                    <Grid Width="34" Height="34" HorizontalAlignment="Center">
                                                        <Border CornerRadius="17"
                                                                BorderThickness="2"
                                                                BorderBrush="{ThemeResource Brush.Accent}"
                                                                Visibility="{x:Bind RingVisibility}" />
                                                        <Border Width="22" Height="22"
                                                                CornerRadius="11"
                                                                Background="{x:Bind Fill}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind Name}"
                                                               FontSize="10.5"
                                                               TextAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{ThemeResource Brush.FgFaint}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!-- 完成页 -->
                            <StackPanel x:Name="PanelDone"
                                        Spacing="14"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="76" Height="76" CornerRadius="38" Background="{ThemeResource Brush.AccentSoft}" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;"
                                              FontSize="34"
                                              Foreground="{ThemeResource Brush.Accent}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="恭喜你完成所有设置了,你现在可以使用 Salmon Launcher 了"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource Brush.Fg}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           MaxWidth="520"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="语言、条款、账户与主题都已配置完成,现在可以开始使用了。"
                                           FontSize="12.5"
                                           Foreground="{ThemeResource Brush.FgDim}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 底部导航 -->
                    <Grid>
                        <Button x:Name="BackBtn"
                                Content="上一步"
                                Click="OnBack"
                                HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <HyperlinkButton x:Name="SkipBtn"
                                             Content="跳过"
                                             Click="OnNext"
                                             Visibility="Collapsed"
                                             VerticalAlignment="Center" />
                            <Button x:Name="NextBtn"
                                    Content="下一步"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Click="OnNext" />
                            <Button x:Name="StartBtn"
                                    Content="开始使用"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Click="OnStart"
                                    Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
