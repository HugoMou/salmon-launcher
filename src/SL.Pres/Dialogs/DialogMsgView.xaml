<dialogs:DialogPanel x:Class="SL.Pres.Dialogs.DialogMsgView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:dialogs="clr-namespace:SL.Pres.Dialogs"
                     xmlns:controls="clr-namespace:SL.Pres.Controls"
                     xmlns:inf="clr-namespace:SL.Pres.Infrastructure">
    <Border Background="{DynamicResource Brush.Card}"
            CornerRadius="{DynamicResource Radius.Dialog}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            Padding="{DynamicResource Pad.Dialog}"
            Width="440">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题行 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Margin="0,2,12,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding KindKey}" Value="Success">
                                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding KindKey}" Value="Warning">
                                    <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding KindKey}" Value="Error">
                                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Glyph}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding KindKey}" Value="Success">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KindKey}" Value="Warning">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KindKey}" Value="Error">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="{DynamicResource Font.Head}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Fg}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- 正文 -->
            <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="{DynamicResource Brush.FgDim}"
                       FontSize="{DynamicResource Font.Body}" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="21" />

            <!-- 按钮行 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <controls:MyButton Style="{StaticResource BtnStyleGhost}" Content="{Binding CancelLabel}"
                        Command="{Binding CancelCommand}" MinWidth="84"
                        Visibility="{Binding AskCancel, Converter={StaticResource BoolToVis}}" />
                <controls:MyButton x:Name="OkButton" Style="{StaticResource BtnStyleAccent}" Content="{Binding OkLabel}"
                        Command="{Binding ConfirmCommand}" MinWidth="104" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</dialogs:DialogPanel>
