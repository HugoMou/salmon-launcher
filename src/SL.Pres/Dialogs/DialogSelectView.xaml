<dialogs:DialogPanel x:Class="SL.Pres.Dialogs.DialogSelectView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:dialogs="clr-namespace:SL.Pres.Dialogs"
                     xmlns:controls="clr-namespace:SL.Pres.Controls"
                     xmlns:inf="clr-namespace:SL.Pres.Infrastructure">
    <Border Background="{DynamicResource Brush.Card}"
            CornerRadius="{DynamicResource Radius.Dialog}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            Padding="{DynamicResource Pad.Dialog}"
            Width="460"
            MaxHeight="560">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="{DynamicResource Font.Head}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Fg}" />

            <TextBlock Grid.Row="1" Text="{Binding Hint}" Foreground="{DynamicResource Brush.FgDim}"
                       FontSize="{DynamicResource Font.Small}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding Hint, Converter={StaticResource EqHidden}}" />

            <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:MyRadioTab Style="{StaticResource Style.NavItem}"
                                                 GroupName="DlgSelectOptions"
                                                 Content="{Binding Name}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 Margin="0,0,0,6" MinHeight="40" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <controls:MyButton Style="{StaticResource BtnStyleGhost}" Content="取消" Command="{Binding CancelCommand}" MinWidth="84" />
                <controls:MyButton Style="{StaticResource BtnStyleAccent}" Content="确定" Command="{Binding ConfirmCommand}"
                        MinWidth="104" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</dialogs:DialogPanel>
