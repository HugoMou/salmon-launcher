<dialogs:DialogPanel x:Class="SL.Pres.Dialogs.DialogInputView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:dialogs="clr-namespace:SL.Pres.Dialogs"
                     xmlns:controls="clr-namespace:SL.Pres.Controls"
                     xmlns:inf="clr-namespace:SL.Pres.Infrastructure">
    <Border Background="{DynamicResource Brush.Card}"
            CornerRadius="{DynamicResource Radius.Dialog}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            Padding="{DynamicResource Pad.Dialog}"
            Width="440">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="{DynamicResource Font.Head}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Fg}" />

            <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="{DynamicResource Brush.FgDim}"
                       FontSize="{DynamicResource Font.Small}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Visibility="{Binding Message, Converter={StaticResource EqHidden}}" />

            <TextBox Grid.Row="2" Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,14,0,0" MinHeight="36" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <controls:MyButton Style="{StaticResource BtnStyleGhost}" Content="取消" Command="{Binding CancelCommand}" MinWidth="84" />
                <controls:MyButton Style="{StaticResource BtnStyleAccent}" Content="确定" Command="{Binding ConfirmCommand}"
                        MinWidth="104" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</dialogs:DialogPanel>
