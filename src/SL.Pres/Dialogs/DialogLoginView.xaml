<dialogs:DialogPanel x:Class="SL.Pres.Dialogs.DialogLoginView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:dialogs="clr-namespace:SL.Pres.Dialogs"
                     xmlns:controls="clr-namespace:SL.Pres.Controls">
    <Border Background="{DynamicResource Brush.Card}"
            CornerRadius="{DynamicResource Radius.Dialog}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            Padding="{DynamicResource Pad.Dialog}"
            Width="440">
        <StackPanel>
            <TextBlock Text="添加账户" FontSize="{DynamicResource Font.Head}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Fg}" />

            <!-- 模式选择 -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <controls:MyRadioTab Style="{StaticResource Style.Chip}" GroupName="LoginModeChips"
                                     Content="离线账户" MinHeight="30"
                                     IsChecked="{Binding Mode, Converter={StaticResource StrEq}, ConverterParameter=offline, Mode=TwoWay}" />
                <controls:MyRadioTab Style="{StaticResource Style.Chip}" GroupName="LoginModeChips"
                                     Content="Microsoft 正版" MinHeight="30" Margin="8,0,0,0"
                                     IsChecked="{Binding Mode, Converter={StaticResource StrEq}, ConverterParameter=online, Mode=TwoWay}"
                                     IsEnabled="False" ToolTip="OAuth 设备码/授权码流程与令牌加密存储将于阶段五接入" />
            </StackPanel>

            <!-- 用户名 -->
            <TextBlock Text="用户名" Foreground="{DynamicResource Brush.FgDim}" FontSize="{DynamicResource Font.Small}"
                       Margin="0,14,0,4" />
            <TextBox Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />

            <!-- 密码(演示) -->
            <TextBlock Text="密码(仅离线/界面演示,真实认证在阶段五接入)" Foreground="{DynamicResource Brush.FgDim}"
                       FontSize="{DynamicResource Font.Small}" Margin="0,12,0,4" />
            <PasswordBox x:Name="PasswordBox" MinHeight="36" />

            <!-- 说明 -->
            <TextBlock Foreground="{DynamicResource Brush.FgFaint}" FontSize="{DynamicResource Font.Small}"
                       Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="离线账户将使用固定命名空间的 UUID 算法生成会话标识;Microsoft 账户令牌在阶段五起加密保存(不明文落盘)。" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <controls:MyButton Style="{StaticResource BtnStyleGhost}" Content="取消" Command="{Binding CancelCommand}" MinWidth="84" />
                <controls:MyButton Style="{StaticResource BtnStyleAccent}" Content="添加账户" Command="{Binding ConfirmCommand}"
                        MinWidth="104" Margin="10,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</dialogs:DialogPanel>
