<UserControl x:Class="SL.Pres.Panels.DownloadPanelLeft"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:SL.Pres.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,10,12,14">

            <TextBlock Text="下载" Style="{StaticResource Style.Sub}" Margin="6,4,0,8" />
            <StackPanel>
                <ctrls:MyRadioTab GroupName="NavDownload" Style="{StaticResource Style.NavItem}" MinHeight="36" Margin="0,2"
                                  Content="游戏版本"
                                  IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=dl.game}"
                                  Command="{Binding NavigateCommand}" CommandParameter="dl.game" />
                <ctrls:MyRadioTab GroupName="NavDownload" Style="{StaticResource Style.NavItem}" MinHeight="36" Margin="0,2"
                                  Content="模组仓库·Modrinth"
                                  IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=dl.pack}"
                                  Command="{Binding NavigateCommand}" CommandParameter="dl.pack" />
                <ctrls:MyRadioTab GroupName="NavDownload" Style="{StaticResource Style.NavItem}" MinHeight="36" Margin="0,2"
                                  Content="光影仓库·Modrinth"
                                  IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=dl.shaders}"
                                  Command="{Binding NavigateCommand}" CommandParameter="dl.shaders" />
                <ctrls:MyRadioTab GroupName="NavDownload" Style="{StaticResource Style.NavItem}" MinHeight="36" Margin="0,2"
                                  Content="资源包仓库·Modrinth"
                                  IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=dl.packs}"
                                  Command="{Binding NavigateCommand}" CommandParameter="dl.packs" />
            </StackPanel>

            <Border Margin="0,16,0,0" Padding="12,10"
                    Background="{DynamicResource Brush.AccentSoft}" CornerRadius="{DynamicResource Radius.Card}">
                <StackPanel>
                    <TextBlock Text="流程说明" FontSize="{DynamicResource Font.Small}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="{DynamicResource Font.Small}"
                               Foreground="{DynamicResource Brush.FgDim}"
                               Text="选择游戏版本 → 选择加载器 → 安装概览,按层级下钻;资源仓库按最近实例落盘,顶部随时可返回。" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
