<UserControl x:Class="SL.Pres.Panels.LaunchPanelLeft"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:SL.Pres.Controls"
             xmlns:inf="clr-namespace:SL.Pres.Infrastructure">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,10,12,14">

            <!-- 实例卡片 -->
            <TextBlock Text="当前实例" Style="{StaticResource Style.Sub}" Margin="6,4,0,8" />
            <Border Style="{StaticResource Style.Card}" Padding="14,12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding InstanceName}" FontSize="{DynamicResource Font.Head}"
                               FontWeight="SemiBold" Foreground="{DynamicResource Brush.Fg}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="{DynamicResource Radius.Pill}" Padding="8,2">
                            <TextBlock Text="{Binding Badge}" FontSize="{DynamicResource Font.Small}"
                                       Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding JavaLine}" Style="{StaticResource Style.Sub}" Margin="0,8,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- 分区内导航 -->
            <TextBlock Text="启动" Style="{StaticResource Style.Sub}" Margin="6,0,0,8" />
            <StackPanel>
                <ctrls:MyRadioTab GroupName="NavLaunch" Style="{StaticResource Style.NavItem}"
                                  MinHeight="36" Margin="0,2"
                                  Content="启动面板"
                                  IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=launch.home}"
                                  Command="{Binding NavigateCommand}" CommandParameter="launch.home" />
                <ctrls:MyRadioTab GroupName="NavLaunch" Style="{StaticResource Style.NavItem}"
                                  MinHeight="36" Margin="0,2"
                                  Content="任务中心"
                                  IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=launch.tasks}"
                                  Command="{Binding NavigateCommand}" CommandParameter="launch.tasks" />
            </StackPanel>

            <!-- 任务提示卡(任务中心页时显示) -->
            <Border Margin="0,14,0,0" Padding="12,10"
                    Background="{DynamicResource Brush.AccentSoft}"
                    CornerRadius="{DynamicResource Radius.Card}"
                    Visibility="{Binding UseTasksHint, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="提示" FontSize="{DynamicResource Font.Small}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock FontSize="{DynamicResource Font.Small}" Foreground="{DynamicResource Brush.FgDim}"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="此页列出全部传输任务:暂停 / 继续 / 取消 / 重试都在这里操作。" />
                </StackPanel>
            </Border>

            <!-- 底部:快速入口 -->
            <Border Margin="0,16,0,0" Padding="12,10" Background="{DynamicResource Brush.Card}"
                    CornerRadius="{DynamicResource Radius.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="账户" Style="{StaticResource Style.Sub}" />
                    <TextBlock Text="{Binding AccountLine}" FontSize="{DynamicResource Font.Body}"
                               Foreground="{DynamicResource Brush.Fg}" Margin="0,3,0,0" />
                    <TextBlock Text="Microsoft 登录暂未开放(离线账户可用)" Style="{StaticResource Style.Sub}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
