<UserControl x:Class="SL.Pres.Panels.ToolsPanelLeft"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:SL.Pres.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,10,12,14">

            <TextBlock Text="工具" Style="{StaticResource Style.Sub}" Margin="6,4,0,8" />
            <StackPanel>
                <ctrls:MyRadioTab GroupName="NavTools" Style="{StaticResource Style.NavItem}" MinHeight="36" Margin="0,2"
                                  Content="联机(VoxLink)"
                                  IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=tools.online}"
                                  Command="{Binding NavigateCommand}" CommandParameter="tools.online" />
                <ctrls:MyRadioTab GroupName="NavTools" Style="{StaticResource Style.NavItem}" MinHeight="36" Margin="0,2"
                                  Content="皮肤站"
                                  IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=tools.skins}"
                                  Command="{Binding NavigateCommand}" CommandParameter="tools.skins" />
                <ctrls:MyRadioTab GroupName="NavTools" Style="{StaticResource Style.NavItem}" MinHeight="36" Margin="0,2"
                                  Content="崩溃诊断"
                                  IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=tools.diag}"
                                  Command="{Binding NavigateCommand}" CommandParameter="tools.diag" />
                <ctrls:MyRadioTab GroupName="NavTools" Style="{StaticResource Style.NavItem}" MinHeight="36" Margin="0,2"
                                  Content="应用日志"
                                  IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=tools.log}"
                                  Command="{Binding NavigateCommand}" CommandParameter="tools.log" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
