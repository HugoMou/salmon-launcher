<UserControl x:Class="SL.Pres.Panels.SettingsPanelLeft"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:SL.Pres.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,10,12,14">

            <TextBlock Text="设置" Style="{StaticResource Style.Sub}" Margin="6,4,0,8" />
            <StackPanel>
                <ctrls:MyRadioTab GroupName="NavSettings" Style="{StaticResource Style.NavItem}" MinHeight="36" Margin="0,2"
                                  Content="启动设置"
                                  IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=st.launch}"
                                  Command="{Binding NavigateCommand}" CommandParameter="st.launch" />
                <ctrls:MyRadioTab GroupName="NavSettings" Style="{StaticResource Style.NavItem}" MinHeight="36" Margin="0,2"
                                  Content="全局偏好"
                                  IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=st.global}"
                                  Command="{Binding NavigateCommand}" CommandParameter="st.global" />
                <ctrls:MyRadioTab GroupName="NavSettings" Style="{StaticResource Style.NavItem}" MinHeight="36" Margin="0,2"
                                  Content="关于"
                                  IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=st.about}"
                                  Command="{Binding NavigateCommand}" CommandParameter="st.about" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
