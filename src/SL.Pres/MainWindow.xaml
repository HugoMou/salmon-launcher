<Window x:Class="SL.Pres.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctrls="clr-namespace:SL.Pres.Controls"
        xmlns:nav="clr-namespace:SL.Pres.Navigation"
        xmlns:inf="clr-namespace:SL.Pres.Infrastructure"
        Title="Salmon Launcher"
        Icon="pack://application:,,,/Assets/Logo.webp"
        Height="760" Width="1240" MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResize"
        Background="{DynamicResource Brush.PageBg}"
        FontFamily="{DynamicResource Font.Global}"
        Foreground="{DynamicResource Brush.Fg}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================== 标题栏 ============================== -->
        <Grid Grid.Row="0" Background="Transparent"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/Logo.webp"
                       Width="22" Height="22" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Salmon Launcher" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="{DynamicResource Font.Body}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Fg}" />
                <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="{DynamicResource Radius.Pill}"
                        Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="0.2" FontSize="11" Foreground="{DynamicResource Brush.Accent}" />
                </Border>
            </StackPanel>

            <!-- 拖拽 / 双击最大化区域 -->
            <Border Grid.Column="1" Background="Transparent" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,4,0">
                <ctrls:MyButton x:Name="BtnMinimize" Style="{StaticResource BtnStyleTitle}"
                                Width="44" Height="32" Content="&#xE921;" FontSize="10"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Click="Minimize_Click" ToolTip="最小化" />
                <ctrls:MyButton x:Name="BtnMaximize" Style="{StaticResource BtnStyleTitle}"
                                Width="44" Height="32" Content="&#xE922;" FontSize="10"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Click="Maximize_Click" ToolTip="最大化 / 还原" />
                <ctrls:MyButton Style="{StaticResource BtnStyleClose}"
                                Width="44" Height="32" Content="&#xE8BB;" FontSize="10"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Click="Close_Click" ToolTip="关闭" />
            </StackPanel>
        </Grid>

        <!-- ============================== 主体：左导航 + 内容 ============================== -->
        <Grid Grid.Row="1" x:Name="BodyRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavCol" Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ctrls:NavRail Grid.Column="0" x:Name="NavHost" />

            <Grid Grid.Column="1" x:Name="PageContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 页头 -->
                <Border Grid.Row="0" Padding="24,18,24,8" Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ctrls:MyButton Grid.Column="0" Style="{StaticResource BtnStyleGhost}"
                                        Content="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        FontSize="12" Width="32" Height="32" Padding="0"
                                        VerticalAlignment="Top" Margin="0,4,12,0"
                                        ToolTip="返回"
                                        Command="{Binding BackCommand}"
                                        Visibility="{Binding CanBack, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Style.Hero}" />
                            <TextBlock Text="{Binding PathText}" Style="{StaticResource Style.Sub}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 页面栈宿主(过渡动画统一协调) -->
                <ctrls:TransitionHost Grid.Row="1" x:Name="PageHost"
                                      Content="{Binding ContentView}"
                                      Direction="{Binding Direction}"
                                      Margin="24,6,24,18" />
            </Grid>

            <!-- ============================== 提示层(非模态) ============================== -->
            <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False">
                <ItemsControl ItemsSource="{Binding Items, Source={x:Static inf:AppServices.Notify}}"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Margin="0,0,18,18" IsHitTestVisible="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Card}"
                                    CornerRadius="{DynamicResource Radius.Card}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    Padding="14,10" MinWidth="280" MaxWidth="420" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding KindKey}" Value="Success">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding KindKey}" Value="Warning">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding KindKey}" Value="Error">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Text}" Margin="10,0,0,0" FontSize="{DynamicResource Font.Body}"
                                               Foreground="{DynamicResource Brush.Fg}" TextWrapping="Wrap"
                                               MaxWidth="330" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CountText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                               FontSize="{DynamicResource Font.Small}" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.FgFaint}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- ============================== 对话框层(模态) ============================== -->
            <Grid x:Name="DialogLayer" Grid.RowSpan="2" Grid.ColumnSpan="2"
                  Background="{DynamicResource Brush.Overlay}"
                  Visibility="Collapsed"
                  Focusable="True"
                  MouseLeftButtonDown="DialogLayer_MouseLeftButtonDown">
                <ContentPresenter x:Name="DialogStage" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Window>
