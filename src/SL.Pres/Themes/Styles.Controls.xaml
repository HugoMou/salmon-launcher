<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrls="clr-namespace:SL.Pres.Controls"
                    xmlns:inf="clr-namespace:SL.Pres.Infrastructure">

    <!-- ============================== 转换器 ============================== -->

    <inf:BoolToVisibility x:Key="BoolToVis" />
    <inf:BoolToVisibility x:Key="BoolHidden" Invert="True" />
    <inf:EqualToVisibility x:Key="EqVis" />
    <inf:EqualToVisibility x:Key="EqHidden" Invert="True" />
    <inf:IntEquals x:Key="IntEq" />
    <inf:StringEquals x:Key="StrEq" />
    <inf:BytesText x:Key="BytesFmt" />
    <inf:KeyIsCurrent x:Key="KeyIsCurrentFmt" />

    <!-- ============================== 基础字体样式 ============================== -->

    <Style x:Key="Style.Hero" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font.Hero}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
    </Style>

    <Style x:Key="Style.Head" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font.Head}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
    </Style>

    <Style x:Key="Style.Sub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.FgDim}" />
    </Style>

    <Style x:Key="Style.Mono" TargetType="TextBlock" BasedOn="{StaticResource Style.Sub}">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Microsoft YaHei UI" />
    </Style>

    <!-- 卡片容器 -->
    <Style x:Key="Style.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource Pad.Card}" />
    </Style>

    <!-- ============================== TextBox ============================== -->

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.AccentSoft}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Body}" />
        <Setter Property="Padding" Value="{DynamicResource Pad.Control}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Control}">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== CheckBox ============================== -->

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                Background="{DynamicResource Brush.Card}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <TextBlock x:Name="Tick" Text="✓" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.AccentFg}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== ProgressBar ============================== -->

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="5" />
        <Setter Property="Background" Value="{DynamicResource Brush.CardPress}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True">
                        <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Slider ============================== -->

    <Style TargetType="Slider">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid MinHeight="26" Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Brush.CardPress}"
                                VerticalAlignment="Center" />
                        <Track x:Name="PART_Track" IsDirectionReversed="False" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Rectangle Fill="Transparent" Height="18" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Rectangle Fill="Transparent" Height="18" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="16" Height="16"
                                                     Fill="{DynamicResource Brush.Accent}"
                                                     Stroke="{DynamicResource Brush.Card}" StrokeThickness="2"
                                                     Cursor="Hand" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== ScrollBar ============================== -->

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Rectangle Fill="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Rectangle Fill="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Width="6" CornerRadius="3" Opacity="0.65"
                                                    Background="{DynamicResource Brush.BorderStrong}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Focusable="False" Opacity="0">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Rectangle Fill="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Focusable="False" Opacity="0">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Rectangle Fill="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Focusable="False">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Height="6" CornerRadius="3" Opacity="0.65"
                                                            Background="{DynamicResource Brush.BorderStrong}" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================== MyButton(标准) ============================== -->

    <Style TargetType="ctrls:MyButton">
        <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
        <Setter Property="HoverBackground" Value="{DynamicResource Brush.CardHover}" />
        <Setter Property="PressedBackground" Value="{DynamicResource Brush.CardPress}" />
        <Setter Property="HoverBorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="Padding" Value="{DynamicResource Pad.Control}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Body}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrls:MyButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Focusable="False"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{Binding HoverBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding HoverBorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{Binding PressedBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="{Binding DisabledOpacity, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnStyleAccent" TargetType="ctrls:MyButton" BasedOn="{StaticResource {x:Type ctrls:MyButton}}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="HoverBackground" Value="{DynamicResource Brush.AccentHover}" />
        <Setter Property="PressedBackground" Value="{DynamicResource Brush.AccentPress}" />
        <Setter Property="HoverBorderBrush" Value="{DynamicResource Brush.AccentHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentFg}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BtnStyleDanger" TargetType="ctrls:MyButton" BasedOn="{StaticResource {x:Type ctrls:MyButton}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HoverBackground" Value="{DynamicResource Brush.DangerSoft}" />
        <Setter Property="PressedBackground" Value="{DynamicResource Brush.DangerSoft}" />
        <Setter Property="HoverBorderBrush" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    </Style>

    <Style x:Key="BtnStyleGhost" TargetType="ctrls:MyButton" BasedOn="{StaticResource {x:Type ctrls:MyButton}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HoverBackground" Value="{DynamicResource Brush.CardHover}" />
        <Setter Property="PressedBackground" Value="{DynamicResource Brush.CardPress}" />
        <Setter Property="HoverBorderBrush" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.FgDim}" />
    </Style>

    <!-- 标题栏小按钮(固定尺寸,悬停底色) -->
    <Style x:Key="BtnStyleTitle" TargetType="ctrls:MyButton" BasedOn="{StaticResource BtnStyleGhost}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- 关闭按钮:悬停红色 -->
    <Style x:Key="BtnStyleClose" TargetType="ctrls:MyButton" BasedOn="{StaticResource BtnStyleTitle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================== MyRadioTab ============================== -->

    <Style TargetType="ctrls:MyRadioTab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HoverBackground" Value="{DynamicResource Brush.CardHover}" />
        <Setter Property="CheckedBackground" Value="{DynamicResource Brush.AccentSoft}" />
        <Setter Property="CheckedForeground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Body}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="ShowLed" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrls:MyRadioTab">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Led" Grid.Column="0" Width="3" Height="16" CornerRadius="2" Margin="0,0,9,0"
                                    Background="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                            <TextBlock x:Name="GlyphTxt" Grid.Column="1" Text="{TemplateBinding Glyph}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                       Margin="0,0,10,0" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter Grid.Column="2" Focusable="False" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Glyph" Value="">
                            <Setter TargetName="GlyphTxt" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{Binding HoverBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{Binding CheckedBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding CheckedBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter Property="Foreground" Value="{Binding CheckedForeground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="ShowLed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Led" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="{Binding DisabledOpacity, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 左侧导航项(WinUI NavigationView 风格) -->
    <Style x:Key="Style.NavItem" TargetType="ctrls:MyRadioTab" BasedOn="{StaticResource {x:Type ctrls:MyRadioTab}}">
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ShowLed" Value="True" />
        <Setter Property="HoverBackground" Value="{DynamicResource Brush.NavItemHover}" />
        <Setter Property="CheckedBackground" Value="{DynamicResource Brush.NavItemChecked}" />
        <Setter Property="CheckedForeground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Body}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- 小 Chip(筛选器/模式选择) -->
    <Style x:Key="Style.Chip" TargetType="ctrls:MyRadioTab" BasedOn="{StaticResource {x:Type ctrls:MyRadioTab}}">
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Small}" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <!-- 标题栏顶级标签 -->
    <Style x:Key="Style.TopTab" TargetType="ctrls:MyRadioTab" BasedOn="{StaticResource {x:Type ctrls:MyRadioTab}}">
        <Setter Property="Padding" Value="22,8" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ============================== TaskCardControl ============================== -->

    <Style TargetType="ctrls:TaskCardControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrls:TaskCardControl">
                    <Border Style="{StaticResource Style.Card}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 标题 + 状态徽章 + 操作 -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{TemplateBinding Title}"
                                           FontSize="{DynamicResource Font.Body}" FontWeight="Medium"
                                           Foreground="{DynamicResource Brush.Fg}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Border x:Name="Badge" Grid.Column="1" CornerRadius="{DynamicResource Radius.Pill}"
                                        Padding="10,3" Margin="8,0,6,0" VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.CardPress}">
                                    <TextBlock x:Name="BadgeTxt" Text="{TemplateBinding StateText}"
                                               FontSize="{DynamicResource Font.Small}"
                                               Foreground="{DynamicResource Brush.FgDim}" />
                                </Border>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ctrls:MyButton x:Name="BtnPause" Style="{StaticResource BtnStyleGhost}"
                                                    Content="暂停" FontSize="12" Padding="10,3"
                                                    Command="{TemplateBinding PauseCommand}" Visibility="Collapsed" />
                                    <ctrls:MyButton x:Name="BtnResume" Style="{StaticResource BtnStyleGhost}"
                                                    Content="继续" FontSize="12" Padding="10,3"
                                                    Command="{TemplateBinding ResumeCommand}" Visibility="Collapsed" />
                                    <ctrls:MyButton x:Name="BtnCancel" Style="{StaticResource BtnStyleGhost}"
                                                    Content="取消" FontSize="12" Padding="10,3"
                                                    Command="{TemplateBinding CancelCommand}" Visibility="Collapsed" />
                                    <ctrls:MyButton x:Name="BtnRetry" Style="{StaticResource BtnStyleGhost}"
                                                    Content="重试" FontSize="12" Padding="10,3"
                                                    Command="{TemplateBinding RetryCommand}" Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>

                            <ProgressBar Grid.Row="1" Margin="0,10,0,0" Maximum="1"
                                         Value="{Binding Progress, RelativeSource={RelativeSource TemplatedParent}}" />

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{TemplateBinding BytesText}" Style="{StaticResource Style.Sub}" />
                                <TextBlock Text="{TemplateBinding SpeedText}" Style="{StaticResource Style.Sub}" Margin="14,0,0,0" />
                                <TextBlock Text="{TemplateBinding RemainText}" Style="{StaticResource Style.Sub}" Margin="14,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="RowState" Value="Downloading">
                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            <Setter TargetName="BadgeTxt" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="BtnPause" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BtnCancel" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="RowState" Value="Verifying">
                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            <Setter TargetName="BadgeTxt" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="BtnCancel" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="RowState" Value="Queued">
                            <Setter TargetName="BtnPause" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BtnCancel" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="RowState" Value="Paused">
                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                            <Setter TargetName="BadgeTxt" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                            <Setter TargetName="BtnResume" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BtnCancel" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="RowState" Value="Failed">
                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                            <Setter TargetName="BadgeTxt" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            <Setter TargetName="BtnRetry" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="RowState" Value="Cancelled">
                            <Setter TargetName="BtnRetry" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- 错误内容出现时,任务卡下方显示错误文本由页面层处理;此处保持无触发 -->
        </Style.Triggers>
    </Style>

    <!-- ============================== TransitionHost ============================== -->

    <Style TargetType="ctrls:TransitionHost">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrls:TransitionHost">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentPresenter x:Name="PART_Current" />
                        <ContentPresenter x:Name="PART_Ghost" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
