<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================== 颜色 ============================== -->

    <SolidColorBrush x:Key="Brush.PageBg" Color="#13191D" />
    <SolidColorBrush x:Key="Brush.PanelBg" Color="#101519" />
    <SolidColorBrush x:Key="Brush.Card" Color="#1C252B" />
    <SolidColorBrush x:Key="Brush.CardHover" Color="#243038" />
    <SolidColorBrush x:Key="Brush.CardPress" Color="#1A2328" />

    <SolidColorBrush x:Key="Brush.Border" Color="#29323A" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#3A454F" />

    <SolidColorBrush x:Key="Brush.Fg" Color="#E9EEF0" />
    <SolidColorBrush x:Key="Brush.FgDim" Color="#9FB0B7" />
    <SolidColorBrush x:Key="Brush.FgFaint" Color="#6E7C84" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#FA8072" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF9D8C" />
    <SolidColorBrush x:Key="Brush.AccentPress" Color="#E26A5C" />
    <SolidColorBrush x:Key="Brush.AccentFg" Color="#2A0F0B" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#2EFA8072" />

    <SolidColorBrush x:Key="Brush.Success" Color="#54C97F" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#2654C97F" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#E3B256" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#2FE3B256" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#EA6A55" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#2BEA6A55" />

    <SolidColorBrush x:Key="Brush.Overlay" Color="#99000000" />

    <!-- 云母背景：半透明窗口 / 导航底色，Windows 11 Mica 可透出桌面壁纸 -->
    <SolidColorBrush x:Key="Brush.WindowTint" Color="#D90F1418" />
    <SolidColorBrush x:Key="Brush.NavBg" Color="#B80F1418" />
    <SolidColorBrush x:Key="Brush.NavItemHover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.NavItemChecked" Color="#1FFA8072" />

    <!-- ============================== 字体 ============================== -->

    <FontFamily x:Key="Font.Global">Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>
    <sys:Double x:Key="Font.Hero" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
    <sys:Double x:Key="Font.Head" xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
    <sys:Double x:Key="Font.Body" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
    <sys:Double x:Key="Font.Small" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>

    <!-- ============================== 形状与间距 ============================== -->

    <CornerRadius x:Key="Radius.Card">8</CornerRadius>
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.Dialog">8</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <Thickness x:Key="Sp.Xs">4</Thickness>
    <Thickness x:Key="Sp.Sm">8</Thickness>
    <Thickness x:Key="Sp.Md">16</Thickness>
    <Thickness x:Key="Sp.Lg">24</Thickness>

    <Thickness x:Key="Pad.Control">14,7</Thickness>
    <Thickness x:Key="Pad.Card">16</Thickness>
    <Thickness x:Key="Pad.Dialog">24</Thickness>

    <!-- ============================== 动画/交互 ============================== -->

    <Duration x:Key="Dur.Trans">0:0:0.22</Duration>
    <Duration x:Key="Dur.Dialog">0:0:0.18</Duration>
    <Duration x:Key="Dur.Quick">0:0:0.12</Duration>

</ResourceDictionary>
