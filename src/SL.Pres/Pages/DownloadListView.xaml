<UserControl x:Class="SL.Pres.Pages.DownloadListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:SL.Pres.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Style.Card}" Margin="0,0,0,14" Padding="18,12">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Style.Head}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Style.Sub}" Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,4,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Style.Card}" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Font.Body}"
                                               FontWeight="Medium" Foreground="{DynamicResource Brush.Fg}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Style.Sub}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Style.Mono}"
                                               FontSize="{DynamicResource Font.Small}" Margin="0,3,0,0" />
                                </StackPanel>

                                <ctrls:MyButton Grid.Column="1" Content="安装" MinWidth="88" MinHeight="34" VerticalAlignment="Center"
                                                Command="{Binding InstallCommand}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
