<UserControl x:Class="SL.Pres.Pages.LoaderListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:SL.Pres.Controls"
             xmlns:pres="clr-namespace:SL.Pres">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Style.Card}" Margin="0,0,0,14" Padding="18,12">
            <StackPanel>
                <TextBlock Text="选择加载器" Style="{StaticResource Style.Head}" />
                <TextBlock Style="{StaticResource Style.Sub}" Margin="0,4,0,0" TextWrapping="Wrap">
                    <Run Text="为 Minecraft " Foreground="{DynamicResource Brush.Fg}" />
                    <Run Text="{x:Static pres:WizardPlan.Version}" Foreground="{DynamicResource Brush.Fg}" />
                    <Run Text=" 选择安装方式;Forge 注册流程在阶段二接入。" />
                </TextBlock>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,4,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ctrls:MyButton Margin="0,0,0,8" Padding="16,12"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding SelectCommand}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Display}" HorizontalAlignment="Left"
                                           FontSize="{DynamicResource Font.Body}" FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis" />

                                <Border Grid.Column="1" Background="{DynamicResource Brush.CardPress}"
                                        CornerRadius="{DynamicResource Radius.Pill}" Padding="10,3" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Badge}" FontSize="{DynamicResource Font.Small}" />
                                </Border>

                                <TextBlock Grid.Column="2" Text="›" FontSize="{DynamicResource Font.Body}"
                                           Foreground="{DynamicResource Brush.FgFaint}" VerticalAlignment="Center" />
                            </Grid>
                        </ctrls:MyButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
