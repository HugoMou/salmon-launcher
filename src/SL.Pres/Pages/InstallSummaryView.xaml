<UserControl x:Class="SL.Pres.Pages.InstallSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:SL.Pres.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,0,0,0">

            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="{Binding PlanTitle}" Style="{StaticResource Style.Hero}" TextWrapping="Wrap" />
                    <TextBlock Text="将执行的内容:" Style="{StaticResource Style.Sub}" Margin="0,10,0,6" />
                    <ItemsControl ItemsSource="{Binding PlanLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="·" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding}" FontSize="{DynamicResource Font.Body}"
                                               Foreground="{DynamicResource Brush.Fg}" Margin="8,0,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14" Padding="16,12">
                <TextBlock Text="{Binding StageNote}" Style="{StaticResource Style.Sub}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal">
                <ctrls:MyButton Style="{StaticResource BtnStyleAccent}" Content="开始安装" MinWidth="140" MinHeight="40"
                                Command="{Binding BeginCommand}" />
                <ctrls:MyButton Content="返回上一步" MinHeight="40" Margin="10,0,0,0" Command="{Binding BackCommand}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
