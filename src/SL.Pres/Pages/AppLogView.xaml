<UserControl x:Class="SL.Pres.Pages.AppLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:SL.Pres.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Style.Card}" Margin="0,0,0,14" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="应用日志" Style="{StaticResource Style.Head}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Style.Sub}" Margin="0,4,0,0" />
                    <TextBox Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="32" VerticalContentAlignment="Center" Margin="0,8,0,0"
                             Background="{DynamicResource Brush.CardPress}" Foreground="{DynamicResource Brush.Fg}"
                             BorderBrush="{DynamicResource Brush.Border}" />
                </StackPanel>

                <ctrls:MyButton Grid.Column="1" Content="刷新" MinWidth="92" MinHeight="36"
                                Margin="10,0,0,0" VerticalAlignment="Bottom"
                                Command="{Binding RefreshCommand}" />
                <ctrls:MyButton Grid.Column="2" Content="打开日志目录" MinWidth="118" MinHeight="36"
                                Margin="10,0,0,0" VerticalAlignment="Bottom"
                                Command="{Binding OpenDirCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Style.Card}" Padding="10,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas"
                                       FontSize="{DynamicResource Font.Small}"
                                       TextWrapping="NoWrap" Foreground="{DynamicResource Brush.FgDim}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
