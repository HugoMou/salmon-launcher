<UserControl x:Class="SL.Pres.Pages.InstanceConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:SL.Pres.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,0,0,0">

            <!-- 内存 -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="内存" Style="{StaticResource Style.Head}" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBox Width="220" Text="{Binding Memory, Mode=TwoWay}" />
                        <ctrls:MyButton Content="打开游戏目录" MinHeight="36" Margin="12,0,0,0"
                                        Command="{Binding OpenFolderCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Style.Sub}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="修改焦点离开输入框后记录演示;全局默认与实例级覆盖的合并逻辑在阶段三生效。" />
                </StackPanel>
            </Border>

            <!-- Java -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Java 运行时" Style="{StaticResource Style.Head}" />
                    <TextBlock Text="{Binding JavaText}" Style="{StaticResource Style.Sub}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- JVM -->
            <Border Style="{StaticResource Style.Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="JVM 参数" Style="{StaticResource Style.Head}" />
                    <TextBlock Text="{Binding JvmHint}" Style="{StaticResource Style.Sub}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
