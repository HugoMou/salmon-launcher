<UserControl x:Class="SL.Pres.Pages.InstanceOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:SL.Pres.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,0,0,0">

            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14" Padding="20,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding InstanceName}" Style="{StaticResource Style.Hero}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="{DynamicResource Radius.Pill}" Padding="10,3">
                                <TextBlock Text="{Binding LoaderBadge}" FontSize="{DynamicResource Font.Small}"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ctrls:MyButton Style="{StaticResource BtnStyleAccent}" Content="▶ 启动" MinWidth="130" MinHeight="40"
                                        FontSize="{DynamicResource Font.Body}" Command="{Binding StartCommand}" />
                        <ctrls:MyButton Content="管理模组" MinHeight="40" Margin="10,0,0,0" Command="{Binding OpenModsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="内存" Style="{StaticResource Style.Sub}" />
                        <TextBlock Text="{Binding MemText}" FontSize="{DynamicResource Font.Body}"
                                   Foreground="{DynamicResource Brush.Fg}" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="内容统计" Style="{StaticResource Style.Sub}" />
                        <TextBlock FontSize="{DynamicResource Font.Body}" Foreground="{DynamicResource Brush.Fg}" Margin="0,4,0,0">
                            <Run Text="{Binding ModsText, Mode=OneWay}" />
                            <Run Text=" · " Foreground="{DynamicResource Brush.FgFaint}" />
                            <Run Text="{Binding SavesText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="最近启动" Style="{StaticResource Style.Sub}" />
                        <TextBlock Text="{Binding LastLaunch}" FontSize="{DynamicResource Font.Body}"
                                   Foreground="{DynamicResource Brush.Fg}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Style.Card}" Padding="16,12">
                <TextBlock Text="{Binding JavaHint}" Style="{StaticResource Style.Sub}" TextWrapping="Wrap" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
