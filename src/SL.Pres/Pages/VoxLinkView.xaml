<UserControl x:Class="SL.Pres.Pages.VoxLinkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:SL.Pres.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Style.Card}" Margin="0,0,0,14" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="联机 · VoxLink(本地信令)" Style="{StaticResource Style.Head}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Style.Sub}"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding InviteText}" Style="{StaticResource Style.Sub}"
                               Margin="0,6,0,0" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <ctrls:MyButton Content="创建房间" MinWidth="120" MinHeight="38"
                                    Command="{Binding HostCommand}" />
                    <ctrls:MyButton Content="加入房间" MinWidth="120" MinHeight="38" Margin="0,8,0,0"
                                    Command="{Binding JoinCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 成员 -->
            <Border Grid.Column="0" Style="{StaticResource Style.Card}" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="{Binding MembersCount}" Style="{StaticResource Style.Sub}"
                               FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Members}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,3" TextTrimming="CharacterEllipsis"
                                           FontSize="{DynamicResource Font.Small}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 消息 -->
            <Border Grid.Column="2" Style="{StaticResource Style.Card}" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3"
                                               FontSize="{DynamicResource Font.Small}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="34" VerticalContentAlignment="Center"
                                 Background="{DynamicResource Brush.CardPress}" Foreground="{DynamicResource Brush.Fg}"
                                 BorderBrush="{DynamicResource Brush.Border}" />
                        <ctrls:MyButton Grid.Column="1" Content="发送" MinWidth="92" MinHeight="34" Margin="10,0,0,0"
                                        Command="{Binding SendCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
