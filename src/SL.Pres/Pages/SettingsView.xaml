<UserControl x:Class="SL.Pres.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:SL.Pres.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0" MaxWidth="920" HorizontalAlignment="Left">

            <!-- ============================== 外观 ============================== -->
            <TextBlock Text="个性化" Style="{StaticResource Style.Head}" Margin="2,0,0,10" />

            <Border Style="{StaticResource Style.Card}" Padding="0" Margin="0,0,0,16">
                <StackPanel>

                    <!-- 主题模式 -->
                    <Grid Margin="20,16,20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="主题模式" FontSize="{DynamicResource Font.Body}"
                                       Foreground="{DynamicResource Brush.Fg}" />
                            <TextBlock Text="黑白可跟随 Windows；也可在此手动指定。" Style="{StaticResource Style.Sub}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ctrls:MyRadioTab GroupName="ThemeChips" Style="{StaticResource Style.Chip}"
                                              Content="浅色"
                                              IsChecked="{Binding ThemeMode, Converter={StaticResource StrEq}, ConverterParameter=light}" />
                            <ctrls:MyRadioTab GroupName="ThemeChips" Style="{StaticResource Style.Chip}" Margin="8,0,0,0"
                                              Content="深色"
                                              IsChecked="{Binding ThemeMode, Converter={StaticResource StrEq}, ConverterParameter=dark}" />
                            <ctrls:MyRadioTab GroupName="ThemeChips" Style="{StaticResource Style.Chip}" Margin="8,0,0,0"
                                              Content="跟随系统"
                                              IsChecked="{Binding ThemeMode, Converter={StaticResource StrEq}, ConverterParameter=system}" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="20,0" />

                    <!-- 配色方案 -->
                    <Grid Margin="20,16,20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,4,12,0">
                            <TextBlock Text="配色方案" FontSize="{DynamicResource Font.Body}"
                                       Foreground="{DynamicResource Brush.Fg}" />
                            <TextBlock Text="整窗底色与卡片色板，与强调色可自由组合。" Style="{StaticResource Style.Sub}"
                                       Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="300" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="360" HorizontalAlignment="Right">
                            <ctrls:MyRadioTab GroupName="PaletteChips" Style="{StaticResource Style.Chip}" Margin="0,2,8,2"
                                              IsChecked="{Binding PaletteId, Converter={StaticResource StrEq}, ConverterParameter=salmon}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="12" Height="12" CornerRadius="3" Background="#1C252B"
                                            BorderBrush="#3A454F" BorderThickness="1" VerticalAlignment="Center" />
                                    <TextBlock Text="鲑鱼暖橙" Margin="7,0,0,0" />
                                </StackPanel>
                            </ctrls:MyRadioTab>
                            <ctrls:MyRadioTab GroupName="PaletteChips" Style="{StaticResource Style.Chip}" Margin="0,2,8,2"
                                              IsChecked="{Binding PaletteId, Converter={StaticResource StrEq}, ConverterParameter=ink}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="12" Height="12" CornerRadius="3" Background="#16212B"
                                            BorderBrush="#35485A" BorderThickness="1" VerticalAlignment="Center" />
                                    <TextBlock Text="墨蓝" Margin="7,0,0,0" />
                                </StackPanel>
                            </ctrls:MyRadioTab>
                            <ctrls:MyRadioTab GroupName="PaletteChips" Style="{StaticResource Style.Chip}" Margin="0,2,8,2"
                                              IsChecked="{Binding PaletteId, Converter={StaticResource StrEq}, ConverterParameter=sand}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="12" Height="12" CornerRadius="3" Background="#241D18"
                                            BorderBrush="#4E4033" BorderThickness="1" VerticalAlignment="Center" />
                                    <TextBlock Text="暖沙" Margin="7,0,0,0" />
                                </StackPanel>
                            </ctrls:MyRadioTab>
                            <ctrls:MyRadioTab GroupName="PaletteChips" Style="{StaticResource Style.Chip}" Margin="0,2,0,2"
                                              IsChecked="{Binding PaletteId, Converter={StaticResource StrEq}, ConverterParameter=slate}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="12" Height="12" CornerRadius="3" Background="#1D1F23"
                                            BorderBrush="#3C4148" BorderThickness="1" VerticalAlignment="Center" />
                                    <TextBlock Text="石板灰" Margin="7,0,0,0" />
                                </StackPanel>
                            </ctrls:MyRadioTab>
                        </WrapPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="20,0" />

                    <!-- 强调色 -->
                    <Grid Margin="20,16,20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="强调色" FontSize="{DynamicResource Font.Body}"
                                       Foreground="{DynamicResource Brush.Fg}" />
                            <TextBlock Text="按钮、选中态与进度条的强调色。" Style="{StaticResource Style.Sub}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ctrls:MyRadioTab GroupName="AccentChips" Style="{StaticResource Style.Chip}" Padding="9,5"
                                              ToolTip="珊瑚橙"
                                              IsChecked="{Binding AccentId, Converter={StaticResource StrEq}, ConverterParameter=coral}">
                                <Ellipse Width="14" Height="14" Fill="#FA8072" />
                            </ctrls:MyRadioTab>
                            <ctrls:MyRadioTab GroupName="AccentChips" Style="{StaticResource Style.Chip}" Padding="9,5" Margin="8,0,0,0"
                                              ToolTip="海洋蓝"
                                              IsChecked="{Binding AccentId, Converter={StaticResource StrEq}, ConverterParameter=ocean}">
                                <Ellipse Width="14" Height="14" Fill="#4CC2FF" />
                            </ctrls:MyRadioTab>
                            <ctrls:MyRadioTab GroupName="AccentChips" Style="{StaticResource Style.Chip}" Padding="9,5" Margin="8,0,0,0"
                                              ToolTip="森林绿"
                                              IsChecked="{Binding AccentId, Converter={StaticResource StrEq}, ConverterParameter=forest}">
                                <Ellipse Width="14" Height="14" Fill="#55C97F" />
                            </ctrls:MyRadioTab>
                            <ctrls:MyRadioTab GroupName="AccentChips" Style="{StaticResource Style.Chip}" Padding="9,5" Margin="8,0,0,0"
                                              ToolTip="薰衣紫"
                                              IsChecked="{Binding AccentId, Converter={StaticResource StrEq}, ConverterParameter=violet}">
                                <Ellipse Width="14" Height="14" Fill="#B68CFF" />
                            </ctrls:MyRadioTab>
                            <ctrls:MyRadioTab GroupName="AccentChips" Style="{StaticResource Style.Chip}" Padding="9,5" Margin="8,0,0,0"
                                              ToolTip="琥珀金"
                                              IsChecked="{Binding AccentId, Converter={StaticResource StrEq}, ConverterParameter=amber}">
                                <Ellipse Width="14" Height="14" Fill="#E8B14C" />
                            </ctrls:MyRadioTab>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource Brush.CardPress}" Padding="20,10">
                        <TextBlock Text="{Binding SystemHint}" Style="{StaticResource Style.Sub}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============================== 下载 ============================== -->
            <TextBlock Text="下载与网络" Style="{StaticResource Style.Head}" Margin="2,0,0,10" />

            <Border Style="{StaticResource Style.Card}" Padding="0" Margin="0,0,0,16">
                <Grid Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="同时下载数" FontSize="{DynamicResource Font.Body}"
                                   Foreground="{DynamicResource Brush.Fg}" />
                        <TextBlock Style="{StaticResource Style.Sub}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Text="{Binding ConcurrencyNote}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Slider Width="220" VerticalAlignment="Center"
                                Minimum="2" Maximum="16" IsSnapToTickEnabled="True" TickFrequency="1"
                                Value="{Binding Concurrency, Mode=TwoWay}" />
                        <Border Background="{DynamicResource Brush.CardPress}" CornerRadius="{DynamicResource Radius.Control}"
                                Padding="10,4" Margin="12,0,0,0" MinWidth="36">
                            <TextBlock Text="{Binding Concurrency}" HorizontalAlignment="Center"
                                       FontSize="{DynamicResource Font.Body}"
                                       Foreground="{DynamicResource Brush.Fg}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================== 启动参数 ============================== -->
            <TextBlock Text="启动" Style="{StaticResource Style.Head}" Margin="2,0,0,10" />

            <Border Style="{StaticResource Style.Card}" Padding="0">
                <Grid Margin="20,16">
                    <StackPanel>
                        <TextBlock Text="内存与 JVM 参数" FontSize="{DynamicResource Font.Body}"
                                   Foreground="{DynamicResource Brush.Fg}" />
                        <TextBlock Style="{StaticResource Style.Sub}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="内存默认值、JVM 参数模板与 Java 自动获取规则在实例设置中按实例配置。" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
