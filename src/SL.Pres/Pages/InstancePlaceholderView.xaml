<UserControl x:Class="SL.Pres.Pages.InstancePlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,0,0,0">

            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Style.Hero}" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Style.Sub}" Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Style.Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="规划能力" Style="{StaticResource Style.Sub}" />
                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="·" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold"
                                               VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding}" FontSize="{DynamicResource Font.Body}"
                                               Foreground="{DynamicResource Brush.Fg}" Margin="8,0,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
