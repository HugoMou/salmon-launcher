<UserControl x:Class="SL.Pres.Pages.TaskCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:SL.Pres.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 头部:汇总 + 批量操作 -->
        <Border Grid.Row="0" Style="{StaticResource Style.Card}" Margin="0,0,0,14" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="任务中心" Style="{StaticResource Style.Head}" />
                        <TextBlock Text="{Binding SummaryText}" Margin="14,0,0,0" VerticalAlignment="Center"
                                   FontSize="{DynamicResource Font.Body}" Foreground="{DynamicResource Brush.FgDim}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ConcurrencyNote}" Style="{StaticResource Style.Sub}" Margin="0,5,0,0" />
                    <TextBlock Style="{StaticResource Style.Sub}" Margin="0,3,0,0"
                               Text="阶段一为模拟数据流:每个任务带主源 + 两级镜像,失败后自动切换镜像源。" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <ctrls:MyButton Content="暂停全部" MinHeight="34" Command="{Binding PauseAllCommand}" />
                    <ctrls:MyButton Content="继续全部" MinHeight="34" Margin="8,0,0,0" Command="{Binding ResumeAllCommand}" />
                    <ctrls:MyButton Content="清理已完成" MinHeight="34" Margin="8,0,0,0" Command="{Binding ClearDoneCommand}" />
                    <ctrls:MyButton Style="{StaticResource BtnStyleAccent}" Content="提交 3 个演示任务" MinHeight="34" Margin="8,0,0,0"
                                    Command="{Binding SpawnDemoCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 任务列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,4,8">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <ctrls:TaskCardControl Title="{Binding Title}"
                                                       PauseCommand="{Binding PauseCommand}"
                                                       ResumeCommand="{Binding ResumeCommand}"
                                                       CancelCommand="{Binding CancelCommand}"
                                                       RetryCommand="{Binding RetryCommand}" />
                                <!-- 错误行(有错误文本才显示) -->
                                <Border Margin="0,4,0,0" Padding="12,8"
                                        Background="{DynamicResource Brush.DangerSoft}"
                                        CornerRadius="{DynamicResource Radius.Control}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ErrorText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ErrorText}" FontSize="{DynamicResource Font.Small}"
                                               Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空状态 -->
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="暂无任务 · 从启动面板或安装概览提交下载"
                           Style="{StaticResource Style.Sub}"
                           Visibility="{Binding EmptyVisible, Converter={StaticResource BoolHidden}}" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
