<UserControl x:Class="SL.Pres.Pages.CrashDiagView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:SL.Pres.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Style.Card}" Margin="0,0,0,14" Padding="18,12">
            <Grid>
                <StackPanel>
                    <TextBlock Text="崩溃诊断" Style="{StaticResource Style.Head}" />
                    <TextBlock Text="读取 instances 下真实崩溃报告与运行日志,按签名给出建议;随时刷新。"
                               Style="{StaticResource Style.Sub}" Margin="0,4,0,0" />
                </StackPanel>
                <ctrls:MyButton HorizontalAlignment="Right" VerticalAlignment="Center"
                                Content="刷新" MinWidth="96" MinHeight="36"
                                Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 报告列表 -->
            <Border Grid.Column="0" Style="{StaticResource Style.Card}" Padding="10,8">
                <ListBox ItemsSource="{Binding Reports}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" TextWrapping="Wrap"
                                       FontSize="{DynamicResource Font.Small}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 诊断 + 正文 -->
            <Border Grid.Column="2" Style="{StaticResource Style.Card}" Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="诊断结论" Style="{StaticResource Style.Sub}" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Findings}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="· " Foreground="{DynamicResource Brush.Fg}" FontSize="{DynamicResource Font.Small}" />
                                        <TextBlock Text="{Binding .}" TextWrapping="Wrap" Margin="0,2"
                                                   Foreground="{DynamicResource Brush.Fg}" FontSize="{DynamicResource Font.Small}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#14000000" CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ExcerptText}" FontFamily="Consolas"
                                       FontSize="{DynamicResource Font.Small}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.FgDim}" />
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <ctrls:MyButton Content="打开报告目录" MinWidth="128" MinHeight="36"
                                        Command="{Binding OpenFileCommand}" />
                        <ctrls:MyButton Content="打开实例根目录" MinWidth="128" MinHeight="36" Margin="10,0,0,0"
                                        Command="{Binding OpenDirCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
