<UserControl x:Class="SL.Pres.Pages.LaunchHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:SL.Pres.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,0,0,0">

            <!-- ============================== 实例主卡 ============================== -->
            <Border Style="{StaticResource Style.Card}" Padding="0" Margin="0,0,0,16" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 渐变封面 -->
                    <Border Grid.Row="0" Height="92">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#E2604B" />
                                <GradientStop Offset="0.55" Color="#B64634" />
                                <GradientStop Offset="1" Color="#6E2A23" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Margin="20,0">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding InstanceName}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"
                                               TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                </StackPanel>
                                <TextBlock Text="{Binding HeroLine}" FontSize="{DynamicResource Font.Small}"
                                           Foreground="#E8FFFFFF" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Text="MINECRAFT" FontSize="26" FontWeight="Bold" Foreground="#30FFFFFF" />
                        </Grid>
                    </Border>

                    <!-- 主操作区 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,16,20,20">
                        <ctrls:MyButton Style="{StaticResource BtnStyleAccent}"
                                        Content="▶ 启动游戏" MinWidth="170" MinHeight="44" FontSize="{DynamicResource Font.Head}"
                                        Command="{Binding StartCommand}" />
                        <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="18,2" />

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Style.Sub}">
                                <Run Text="账户:" />
                                <Run Text="{Binding AccountText, Mode=OneWay}" Foreground="{DynamicResource Brush.Fg}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Style.Sub}" Margin="0,3,0,0">
                                <Run Text="下载:" />
                                <Run Text="{Binding SummaryLine, Mode=OneWay}" Foreground="{DynamicResource Brush.Fg}" />
                            </TextBlock>
                        </StackPanel>

                        <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="18,2" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConcurrencyNote}" Style="{StaticResource Style.Sub}" />
                            <TextBlock Text="{Binding SaveText}" Style="{StaticResource Style.Sub}" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================== 信息卡 -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,16" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,20,12">
                        <TextBlock Text="运行环境" Style="{StaticResource Style.Sub}" />
                        <TextBlock Text="{Binding JavaStatus}" FontSize="{DynamicResource Font.Body}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Brush.Fg}" />
                        <TextBlock Text="{Binding MemText}" Style="{StaticResource Style.Sub}" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,20,12">
                        <TextBlock Text="内容" Style="{StaticResource Style.Sub}" />
                        <TextBlock Text="{Binding ModsText}" FontSize="{DynamicResource Font.Body}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Brush.Fg}" />
                        <TextBlock Text="{Binding SaveText}" Style="{StaticResource Style.Sub}" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================== 入口行 ============================== -->
            <Border Style="{StaticResource Style.Card}" Padding="14">
                <StackPanel Orientation="Horizontal">
                    <ctrls:MyButton Style="{StaticResource BtnStyleGhost}" Content="实例概览" MinHeight="34"
                                    Command="{Binding EditConfigCommand}" />
                    <ctrls:MyButton Style="{StaticResource BtnStyleGhost}" Content="打开游戏目录" MinHeight="34" Margin="8,0,0,0"
                                    Command="{Binding OpenFolderCommand}" />
                    <ctrls:MyButton Style="{StaticResource BtnStyleGhost}" Content="补一个演示任务" MinHeight="34" Margin="8,0,0,0"
                                    Command="{Binding SpawnTaskCommand}" />
                    <ctrls:MyButton Style="{StaticResource BtnStyleGhost}" Content="任务中心 ›" MinHeight="34" Margin="8,0,0,0"
                                    Command="{Binding OpenTasksCommand}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
