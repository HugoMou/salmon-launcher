<UserControl x:Class="SL.Pres.Pages.ModrinthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:SL.Pres.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 头部 + 搜索框 -->
        <Border Grid.Row="0" Style="{StaticResource Style.Card}" Margin="0,0,0,14" Padding="18,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Style.Head}" />
                    <TextBlock Text="{Binding InstanceHint}" Style="{StaticResource Style.Sub}" Margin="0,4,0,0" />
                </StackPanel>

                <ctrls:MyButton Grid.Row="0" Grid.Column="1" Style="{StaticResource BtnStyleAccent}"
                                Content="搜索" MinWidth="96" MinHeight="40" VerticalAlignment="Center"
                                Command="{Binding SearchCommand}" />

                <TextBox x:Name="SearchBox" Grid.Row="1" Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="36" VerticalContentAlignment="Center" Margin="0,10,0,0"
                         Background="{DynamicResource Brush.CardPress}" Foreground="{DynamicResource Brush.Fg}"
                         BorderBrush="{DynamicResource Brush.Border}" />

                <TextBlock Grid.Row="2" Text="{Binding StatusText}" Style="{StaticResource Style.Sub}" Margin="0,6,0,0" />
            </Grid>
        </Border>

        <!-- 结果列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,4,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Style.Card}" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Font.Body}"
                                               FontWeight="Medium" Foreground="{DynamicResource Brush.Fg}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Style.Sub}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Style.Sub}"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <ctrls:MyButton Grid.Column="1" Content="安装" MinWidth="88" MinHeight="34"
                                                VerticalAlignment="Center" Command="{Binding InstallCommand}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
