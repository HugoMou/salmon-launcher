<UserControl x:Class="SL.Pres.Pages.InstanceModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:SL.Pres.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Border Grid.Row="0" Style="{StaticResource Style.Card}" Margin="0,0,0,14" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="模组管理" Style="{StaticResource Style.Head}" />
                    <TextBlock Style="{StaticResource Style.Sub}" Margin="0,4,0,0"
                               Text="启停为 .jar ↔ .jar.disabled 重命名(演示);真实文件操作在阶段四接入。" />
                </StackPanel>

                <ctrls:MyButton Grid.Column="1" Style="{StaticResource BtnStyleAccent}"
                                Content="＋ 添加模组" MinHeight="36" VerticalAlignment="Center"
                                Command="{Binding AddModCommand}" />
            </Grid>
        </Border>

        <!-- 模组列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,4,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Style.Card}" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" VerticalAlignment="Center" IsChecked="{Binding Enabled}" />

                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Font.Body}"
                                               FontWeight="Medium" Foreground="{DynamicResource Brush.Fg}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FileName}" Style="{StaticResource Style.Mono}"
                                               FontSize="{DynamicResource Font.Small}" Margin="0,3,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Brush.CardPress}" CornerRadius="{DynamicResource Radius.Pill}"
                                            Padding="10,3" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding LoaderBadge}" FontSize="{DynamicResource Font.Small}"
                                                   Foreground="{DynamicResource Brush.FgDim}" />
                                    </Border>
                                    <Border CornerRadius="{DynamicResource Radius.Pill}" Padding="10,3" Margin="0,0,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.CardPress}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StateBadge}" FontSize="{DynamicResource Font.Small}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.FgDim}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <ctrls:MyButton Style="{StaticResource BtnStyleDanger}" Content="删除" FontSize="12"
                                                    Padding="12,4" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
